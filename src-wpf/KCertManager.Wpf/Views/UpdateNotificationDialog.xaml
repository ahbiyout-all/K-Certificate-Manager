<Window x:Class="KCertManager.Wpf.Views.UpdateNotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="K-인증서 매니저 - 최신 버전 업데이트 알림" 
        Height="460" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="4"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgDarkBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Banner -->
            <Border Grid.Row="0" Background="{DynamicResource AccentBlueBrush}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Background="#3B82F6" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="새로운 업데이트 버전 감지!" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="K-인증서 매니저 최신 배포판이 준비되었습니다" FontSize="11" Foreground="#DBEAFE" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Click="Close_Click" Style="{StaticResource TitleBarCloseButton}" VerticalAlignment="Top">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <StackPanel Grid.Row="1" Margin="20,16,20,16">
                <!-- Version Comparison Card -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="현재 설치 버전" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,4" Margin="0,4,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock x:Name="TxtCurrentVersion" Text="v1.4.5" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="➔" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="10,0"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="GitHub 최신 버전" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <Border Background="#2563EB" CornerRadius="6" Padding="10,4" Margin="0,4,0,0">
                                <TextBlock x:Name="TxtLatestVersion" Text="v1.7.0" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GitHub Path Banner -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🔗 공식 GitHub 저장소 경로" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtGithubUrl" Text="https://github.com/ahbiyout-all/K-Certificate-Manager" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Release Notes -->
                <TextBlock Text="📝 업데이트 변경 내용" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Height="100">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtReleaseNotes" Text="• 인증서 복사 및 검증 알고리즘 강화&#10;• 보안 패치 및 사용자 편의 UI 개선" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Bottom Action Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <Button Click="OpenGithubRepo_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,4,0"/>
                            <TextBlock Text="GitHub 저장소 보기"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="Close_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8">
                            <TextBlock Text="나중에 하기"/>
                        </Button>
                        <Button Click="DownloadUpdate_Click" Style="{StaticResource SuccessButton}" Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,4,0"/>
                                <TextBlock Text="지금 업데이트 (다운로드)"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
