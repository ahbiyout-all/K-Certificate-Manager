<Window x:Class="KCertManager.Wpf.Views.ExpiredCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="만료 인증서 안전 정리 (실수 방지 매체 선택)"
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" Background="#881337" CornerRadius="8" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🧹" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="만료 인증서 안전 정리 (실수 방지 매체 선택)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="사용자 실수로 인한 의도치 않은 삭제를 방지하기 위해 데스크탑(PC) 또는 USB 드라이브를 명확히 선택하도록 지원합니다." FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Medium Selector Cards -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="1단계: 정리 대상 저장 매체 선택 (사용자 실수 방지)" FontSize="12" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,10"/>
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Desktop (PC) Option -->
                    <Border x:Name="BorderDesktop" Grid.Column="0" CornerRadius="8" Padding="12" BorderThickness="2" BorderBrush="#2563EB" Background="#1E3A8A" MouseLeftButtonUp="SelectDesktop_Click" Cursor="Hand">
                        <StackPanel>
                            <RadioButton x:Name="RadioDesktop" Content="💻 컴퓨터(PC) 로컬만" GroupName="MediumFilter" FontWeight="Bold" Foreground="White" FontSize="13" Checked="RadioMedium_Checked"/>
                            <TextBlock x:Name="TxtDesktopCount" Text="0건 대상" FontSize="11" Foreground="#93C5FD" FontWeight="SemiBold" Margin="20,4,0,2"/>
                            <TextBlock Text="PC 로컬 C: 드라이브만 대상&#x0a;(연결된 USB는 안전 보존)" FontSize="10" Foreground="#CBD5E1" Margin="20,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- USB Option -->
                    <Border x:Name="BorderUsb" Grid.Column="2" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#334155" Background="#0F172A" MouseLeftButtonUp="SelectUsb_Click" Cursor="Hand">
                        <StackPanel>
                            <RadioButton x:Name="RadioUsb" Content="💾 USB 이동식만" GroupName="MediumFilter" FontWeight="Bold" Foreground="White" FontSize="13" Checked="RadioMedium_Checked"/>
                            <TextBlock x:Name="TxtUsbCount" Text="0건 대상" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" Margin="20,4,0,2"/>
                            <TextBlock Text="이동식 USB 드라이브만 대상&#x0a;(컴퓨터 PC 로컬은 안전 보존)" FontSize="10" Foreground="#94A3B8" Margin="20,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- All Option -->
                    <Border x:Name="BorderAll" Grid.Column="4" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#334155" Background="#0F172A" MouseLeftButtonUp="SelectAll_Click" Cursor="Hand">
                        <StackPanel>
                            <RadioButton x:Name="RadioAll" Content="🌐 전체 매체 동시" GroupName="MediumFilter" FontWeight="Bold" Foreground="White" FontSize="13" Checked="RadioMedium_Checked"/>
                            <TextBlock x:Name="TxtAllCount" Text="0건 대상" FontSize="11" Foreground="#F87171" FontWeight="SemiBold" Margin="20,4,0,2"/>
                            <TextBlock Text="PC 및 USB 전체 동시 정리&#x0a;(주의하여 선택)" FontSize="10" Foreground="#94A3B8" Margin="20,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Safety Alert Callout -->
                <Border x:Name="BorderAlert" Background="#0F172A" CornerRadius="6" Padding="10,8" BorderBrush="#2563EB" BorderThickness="1">
                    <TextBlock x:Name="TxtSafetyNotice" Text="🛡️ [실수 방지 활성화] 데스크탑(PC) 로컬의 만료 인증서만 정리됩니다. 연결된 USB 드라이브의 인증서는 안전하게 보호됩니다." FontSize="11" Foreground="#93C5FD" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Certificate DataGrid -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="2" BorderBrush="#334155" BorderThickness="1">
            <DataGrid x:Name="GridCerts"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      Background="#1E293B"
                      RowBackground="#1E293B"
                      AlternatingRowBackground="#0F172A"
                      Foreground="#F8FAFC"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#334155"
                      HeadersVisibility="Column"
                      RowHeight="38">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="저장 위치" Binding="{Binding StorageLocationBadge}" Width="120"/>
                    <DataGridTextColumn Header="인증서 명칭" Binding="{Binding CommonName}" Width="180"/>
                    <DataGridTextColumn Header="분류" Binding="{Binding CategoryBadgeText}" Width="110"/>
                    <DataGridTextColumn Header="만료 일시" Binding="{Binding NotAfter, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                    <DataGridTextColumn Header="상태" Binding="{Binding StatusDisplayText}" Width="80"/>
                    <DataGridTemplateColumn Header="보관 경로" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DirectoryPath}" 
                                           Foreground="#CBD5E1" 
                                           FontSize="11" 
                                           TextWrapping="Wrap" 
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding DirectoryPath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Actions and Consent -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,14,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <CheckBox x:Name="ChkConfirm" Content="위 내용을 확인하였으며, 선택한 매체의 만료 인증서를 안전 격리 휴지통으로 이동하는 것에 동의합니다."
                              Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" Click="ChkConfirm_Click"/>
                    <TextBlock x:Name="TxtTargetSummary" Text="정리 대상: 0건 선택됨" FontSize="11" Foreground="#94A3B8" Margin="22,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="취소" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" Margin="0,0,8,0" Width="80"/>
                    <Button x:Name="BtnExecute" Content="만료 인증서 정리 실행" Style="{StaticResource DangerButton}" Click="BtnExecute_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
