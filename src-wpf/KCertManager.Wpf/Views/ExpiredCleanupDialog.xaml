<Window x:Class="KCertManager.Wpf.Views.ExpiredCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="만료된 인증서 정리"
        Width="984" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" Background="#881337" CornerRadius="8" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🧹" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="만료된 인증서 정리" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="삭제할 저장 위치(PC 또는 USB)를 먼저 선택하세요." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Medium Selector Cards -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="1단계: 정리할 저장 위치 선택" FontSize="12" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,10"/>
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Desktop (PC) Option -->
                    <Border x:Name="BorderDesktop" Grid.Column="0" CornerRadius="8" Padding="12" BorderThickness="2" BorderBrush="#2563EB" Background="#1E3A8A" MouseLeftButtonUp="SelectDesktop_Click" Cursor="Hand">
                        <StackPanel>
                            <RadioButton x:Name="RadioDesktop" Content="💻 내 컴퓨터(PC)만" GroupName="MediumFilter" FontWeight="Bold" Foreground="White" FontSize="13" Checked="RadioMedium_Checked"/>
                            <TextBlock x:Name="TxtDesktopCount" Text="0건 대상" FontSize="11" Foreground="#93C5FD" FontWeight="SemiBold" Margin="20,4,0,2"/>
                            <TextBlock Text="PC 저장소만 정리 (USB 보호)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- USB Option -->
                    <Border x:Name="BorderUsb" Grid.Column="2" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BgDarkBrush}" MouseLeftButtonUp="SelectUsb_Click" Cursor="Hand">
                        <StackPanel>
                            <RadioButton x:Name="RadioUsb" Content="💾 USB 메모리만" GroupName="MediumFilter" FontWeight="Bold" Foreground="White" FontSize="13" Checked="RadioMedium_Checked"/>
                            <TextBlock x:Name="TxtUsbCount" Text="0건 대상" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" Margin="20,4,0,2"/>
                            <TextBlock Text="USB 메모리만 정리 (PC 보호)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- All Option -->
                    <Border x:Name="BorderAll" Grid.Column="4" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BgDarkBrush}" MouseLeftButtonUp="SelectAll_Click" Cursor="Hand">
                        <StackPanel>
                            <RadioButton x:Name="RadioAll" Content="🌐 PC · USB 모두" GroupName="MediumFilter" FontWeight="Bold" Foreground="White" FontSize="13" Checked="RadioMedium_Checked"/>
                            <TextBlock x:Name="TxtAllCount" Text="0건 대상" FontSize="11" Foreground="#F87171" FontWeight="SemiBold" Margin="20,4,0,2"/>
                            <TextBlock Text="PC와 USB 모두 정리 (주의)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Safety Alert Callout -->
                <Border x:Name="BorderAlert" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,8" BorderBrush="#2563EB" BorderThickness="1">
                    <TextBlock x:Name="TxtSafetyNotice" Text="🛡️ 내 컴퓨터(PC)의 만료 인증서만 정리합니다. USB 인증서는 유지됩니다." FontSize="11" Foreground="#93C5FD" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Certificate DataGrid -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="GridCerts"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      Background="{DynamicResource BgCardBrush}"
                      RowBackground="{DynamicResource BgCardBrush}"
                      AlternatingRowBackground="{DynamicResource BgDarkBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      HeadersVisibility="Column"
                      RowHeight="38"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="False">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="번호" Binding="{Binding IndexNumber}" Width="50" MinWidth="35" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <DataGridTextColumn Header="저장 위치" Binding="{Binding StorageLocationBadge}" Width="120" MinWidth="70"/>
                    <DataGridTextColumn Header="인증서 명칭" Binding="{Binding CommonName}" Width="200" MinWidth="200"/>
                    <DataGridTextColumn Header="분류" Binding="{Binding CategoryBadgeText}" Width="110" MinWidth="60"/>
                    <DataGridTextColumn Header="만료 일시" Binding="{Binding NotAfter, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" MinWidth="80"/>
                    <DataGridTextColumn Header="상태" Binding="{Binding StatusDisplayText}" Width="80" MinWidth="50"/>
                    <DataGridTemplateColumn Header="보관 경로" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DirectoryPath}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           FontSize="11" 
                                           TextWrapping="Wrap" 
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding DirectoryPath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Actions and Consent -->
        <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,10" Margin="0,14,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <CheckBox x:Name="ChkConfirm" Content="선택한 저장 위치의 만료 인증서를 휴지통으로 옮기는 데 동의합니다."
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" Click="ChkConfirm_Click"/>
                    <TextBlock x:Name="TxtTargetSummary" Text="정리 대상: 0건 선택됨" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="22,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="취소" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" Margin="0,0,8,0" Width="80"/>
                    <Button x:Name="BtnExecute" Content="만료 인증서 정리 실행" Style="{StaticResource DangerButton}" Click="BtnExecute_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
