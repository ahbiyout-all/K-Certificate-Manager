<Window x:Class="KCertManager.Wpf.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="환경 설정 (Application Settings) - K-인증서 매니저" 
        Height="660" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" Background="#1E3A8A" CornerRadius="8" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="환경 설정 (Preferences)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="알림음, 테마, 화면 모드 및 시작 옵션 설정" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Group 1: 성공 알림음 (SuccessChime) & 볼륨 슬라이더 -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🔔" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="복사 완료 알림음" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="인증서 복사가 끝나면 소리로 알려줍니다." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <!-- Toggle Enable -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="알림음 사용" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="복사 완료 및 오류 발생 시 알림음을 재생합니다." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkSoundEnabled" Grid.Column="1" VerticalAlignment="Center"
                                      Checked="ChkSoundEnabled_Changed" Unchecked="ChkSoundEnabled_Changed"/>
                        </Grid>

                        <!-- Volume Horizontal Slider -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="알림음 크기:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Slider x:Name="SliderSoundVolume" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                    VerticalAlignment="Center" ValueChanged="SliderSoundVolume_ValueChanged"/>

                            <TextBlock x:Name="TxtSoundVolume" Grid.Column="2" Text="40%" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </Grid>

                        <!-- Header Sound Bar Toggle CheckBox -->
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="상단 알림음 조절바 표시" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="화면 위쪽 메뉴에 볼륨 조절바를 표시합니다." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkShowHeaderSoundBar" Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowHeaderSoundBar, Mode=TwoWay}"
                                      Checked="ChkShowHeaderSoundBar_Changed" Unchecked="ChkShowHeaderSoundBar_Changed"/>
                        </Grid>

                        <!-- Phase Test Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="음향 미리듣기:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnTestStartSound" Click="BtnTestStartSound_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" ToolTip="시작음 미리듣기">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" Margin="0,0,4,0" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="시작음" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnTestSound" Click="BtnTestSound_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" ToolTip="완료음 미리듣기">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎉" Margin="0,0,4,0" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="완료음" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnTestErrorSound" Click="BtnTestErrorSound_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" ToolTip="오류음 미리듣기">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" Margin="0,0,4,0" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="오류음" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Group 2: 화면 테마 스타일 -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🎨" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="화면 테마" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbThemeDark" Content="다크 테마 (Dark)" Margin="0,0,16,8" GroupName="DialogThemeGroup" Checked="RbTheme_Checked"/>
                            <RadioButton x:Name="RbThemeGray" Content="회색 테마 (Gray)" Margin="0,0,16,8" GroupName="DialogThemeGroup" Checked="RbTheme_Checked"/>
                            <RadioButton x:Name="RbThemeWhite" Content="화이트 테마 (White)" Margin="0,0,16,8" GroupName="DialogThemeGroup" Checked="RbTheme_Checked"/>
                            <RadioButton x:Name="RbThemeBeige" Content="베이지 테마 (Beige)" Margin="0,0,16,8" GroupName="DialogThemeGroup" Checked="RbTheme_Checked"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Group 3: 인터페이스 모드 -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🖥️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="화면 모드" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <RadioButton x:Name="RbModeSimple" Content="간편 모드 (복사·목록 중심의 쉬운 화면)" Margin="0,0,0,8" GroupName="DialogModeGroup" Checked="RbMode_Checked"/>
                        <RadioButton x:Name="RbModeAdvanced" Content="상세 모드 (드라이브·부가 도구 모두 표시)" Margin="0,0,0,0" GroupName="DialogModeGroup" Checked="RbMode_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Group 4: 인증서 탐색 및 GPKI 경로 최적화 -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="공무원 인증서 (GPKI) 탐색 범위" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <CheckBox x:Name="ChkExcludeLocalLowGpkiScan"
                                  IsChecked="{Binding ExcludeLocalLowGpkiScan, Mode=TwoWay}"
                                  Checked="ChkExcludeLocalLowGpkiScan_Changed" Unchecked="ChkExcludeLocalLowGpkiScan_Changed"
                                  FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4">
                            <TextBlock Text="실무 미사용 폴더 제외 (AppData\LocalLow\GPKI, 권장)"/>
                        </CheckBox>
                        <TextBlock Text="공식 폴더(C:\GPKI) 외에 쓰이지 않는 임시 폴더는 건너뜁니다."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="20,0,0,4"/>
                        <Expander Header="자세히 보기" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="20,2,0,0">
                            <TextBlock Text="온-나라·새올 등 행정망은 C:\GPKI\Certificate\class2 경로만 사용합니다. 체크를 해제하면 AppData\LocalLow\GPKI 경로도 함께 검색하며 경고 배지가 표시됩니다."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Group 5: USB 탐색기 자동 열기 옵션 -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="USB 폴더 자동 열기" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkAutoOpenUsbFolderOnComplete"
                                  IsChecked="{Binding AutoOpenUsbFolderOnComplete, Mode=TwoWay}"
                                  Checked="ChkAutoOpenUsbFolderOnComplete_Changed" Unchecked="ChkAutoOpenUsbFolderOnComplete_Changed"
                                  FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4">
                            <TextBlock Text="복사 완료 시 USB 폴더 자동 열기"/>
                        </CheckBox>
                        <TextBlock Text="복사가 끝나면 탐색기로 USB 폴더를 바로 엽니다."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="20,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Group 6: 시작 옵션 -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🚀" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="시작 옵션" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 'Don't show startup workflow again' CheckBox bound with Mode=TwoWay -->
                        <CheckBox x:Name="ChkDontShowStartupWorkflowAgain"
                                  Content="시작할 때 작업 선택 창 다시 보지 않기"
                                  IsChecked="{Binding DontShowStartupWorkflowAgain, Mode=TwoWay}"
                                  FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Button x:Name="BtnResetDefaults" Click="BtnResetDefaults_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,4,0"/>
                        <TextBlock Text="기본값으로 복원" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="20,6">
                    <TextBlock Text="닫기" FontSize="12" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
