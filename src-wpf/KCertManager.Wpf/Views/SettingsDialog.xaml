<Window x:Class="KCertManager.Wpf.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="환경 설정 (Application Settings) - K-인증서 매니저" 
        Height="580" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" Background="#1E3A8A" CornerRadius="8" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="환경 설정 (Preferences)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="복사 성공 알림음(SuccessChime), 테마 스타일, 인터페이스 모드 및 시작 옵션 설정" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Group 1: 성공 알림음 (SuccessChime) & 볼륨 슬라이더 -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔔" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="복사 성공 알림음 (SuccessChime)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="인증서 복사 또는 백업이 완료되었을 때 청각적 피드백을 제공합니다." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <!-- Toggle Enable -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="작업 완료 알림음 사용" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="인증서 전송 및 복사 성공 시 경쾌한 알림음을 재생합니다." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkSoundEnabled" Grid.Column="1" VerticalAlignment="Center"
                                      Checked="ChkSoundEnabled_Changed" Unchecked="ChkSoundEnabled_Changed"/>
                        </Grid>

                        <!-- Volume Horizontal Slider -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="알림음 볼륨:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Slider x:Name="SliderSoundVolume" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                    VerticalAlignment="Center" ValueChanged="SliderSoundVolume_ValueChanged"/>

                            <TextBlock x:Name="TxtSoundVolume" Grid.Column="2" Text="40%" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>

                            <Button x:Name="BtnTestSound" Grid.Column="3" Click="BtnTestSound_Click"
                                    Style="{StaticResource SecondaryButton}" Padding="10,4" ToolTip="알림음 미리듣기">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶" Margin="0,0,4,0" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="미리듣기" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Group 2: 화면 테마 스타일 -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🎨" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="화면 테마 스타일 (Theme)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbThemeDark" Content="다크 테마 (Dark)" Margin="0,0,16,8" GroupName="DialogThemeGroup" Checked="RbTheme_Checked"/>
                            <RadioButton x:Name="RbThemeGray" Content="회색 테마 (Gray)" Margin="0,0,16,8" GroupName="DialogThemeGroup" Checked="RbTheme_Checked"/>
                            <RadioButton x:Name="RbThemeWhite" Content="화이트 테마 (White)" Margin="0,0,16,8" GroupName="DialogThemeGroup" Checked="RbTheme_Checked"/>
                            <RadioButton x:Name="RbThemeBeige" Content="베이지 테마 (Beige)" Margin="0,0,16,8" GroupName="DialogThemeGroup" Checked="RbTheme_Checked"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Group 3: 인터페이스 모드 -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🖥️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="화면 인터페이스 모드 (UI Mode)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <RadioButton x:Name="RbModeSimple" Content="초보자용 간편 모드 (핵심 원클릭 복사와 목록에 집중)" Margin="0,0,0,8" GroupName="DialogModeGroup" Checked="RbMode_Checked"/>
                        <RadioButton x:Name="RbModeAdvanced" Content="전문가용 상세 모드 (드라이브 상세 규격, 진단 및 모든 고급 도구 표시)" Margin="0,0,0,0" GroupName="DialogModeGroup" Checked="RbMode_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Group 4: 시작 옵션 -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🚀" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="시작 가이드 옵션" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkShowStartupGuide"
                                  Content="앱 실행 시 시작 가이드 창 자동 표시"
                                  IsChecked="{Binding DontShowStartupWorkflowAgain, Mode=TwoWay, Converter={StaticResource InverseBoolConverter}}"
                                  Checked="ChkShowStartupGuide_Changed" Unchecked="ChkShowStartupGuide_Changed"/>
                        <CheckBox x:Name="ChkDontShowStartupGuide"
                                  Content="앱 시작 시 작업 선택(시작 가이드) 창을 다시 표시하지 않음 (Don't show again)"
                                  IsChecked="{Binding DontShowStartupWorkflowAgain, Mode=TwoWay}"
                                  Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Button x:Name="BtnResetDefaults" Click="BtnResetDefaults_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,4,0"/>
                        <TextBlock Text="기본값으로 복원" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="20,6">
                    <TextBlock Text="닫기" FontSize="12" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
