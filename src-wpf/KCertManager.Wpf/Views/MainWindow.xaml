<Window x:Class="KCertManager.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:KCertManager.Wpf.ViewModels"
        xmlns:models="clr-namespace:KCertManager.Wpf.Models"
        Title="K-인증서 매니저 (K-Certificate Manager)" 
        Height="840" Width="1380"
        MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border x:Name="RootWindowBorder" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid x:Name="RootLayoutGrid" Background="{DynamicResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Modern Integrated TitleBar & Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0,10,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Title (Draggable Area) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" ClipToBounds="True" Background="Transparent">
                        <Grid>
                            <Image x:Name="AppLogoImage" 
                                   Source="/Assets/app-logo.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform" 
                                   Width="34" Height="34"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="K-인증서 매니저" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header Action Tools & Theme Selector (Dedicated Column 1, Aligned Right) -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="10,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Theme Switcher Dropdown (ComboBox) -->
                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="4,2" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎨" FontSize="11" VerticalAlignment="Center" Margin="3,0,4,0"/>
                                <ComboBox SelectedValue="{Binding CurrentTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag" Width="98" Height="26" VerticalContentAlignment="Center"
                                          ToolTip="원하는 화면 테마 스타일을 선택하세요.">
                                    <ComboBoxItem Content="다크 테마" Tag="dark"/>
                                    <ComboBoxItem Content="회색 테마" Tag="gray"/>
                                    <ComboBoxItem Content="화이트 테마" Tag="white"/>
                                    <ComboBoxItem Content="베이지 테마" Tag="beige"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Mode Switch: [간편 모드] vs [상세 모드] -->
                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="UIModeGroup" Content="간편 모드" IsChecked="{Binding IsSimpleMode, Mode=TwoWay}"
                                             Style="{StaticResource ModeToggleRadio}" ToolTip="초보자용 간편 모드: 핵심 복사 기능과 목록에 집중합니다."/>
                                <RadioButton GroupName="UIModeGroup" Content="상세 모드" IsChecked="{Binding IsAdvancedUIMode, Mode=TwoWay}"
                                             Style="{StaticResource ModeToggleRadio}" ToolTip="전문가용 상세 모드: 드라이브 상세 정보 및 부가 도구를 모두 표시합니다."/>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding ShowStartupWorkflowCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" ToolTip="시작 작업 선택 창 및 순서별 가이드 모션을 다시 실행합니다.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" Margin="0,0,4,0"/>
                                <TextBlock Text="시작 가이드" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,4,0"/>
                                <TextBlock Text="새로고침"/>
                            </StackPanel>
                        </Button>

                        <Button Click="OpenTrash_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding TrashCount, StringFormat='{}휴지통 ({0})'}" Foreground="#FDA4AF"/>
                            </StackPanel>
                        </Button>

                        <!-- Advanced Mode Only Quick Tools (reduces cognitive clutter in Simple Mode) -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsAdvancedUIMode, Converter={StaticResource BoolToVis}}">
                            <Button Click="OpenSearchLocations_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" Margin="0,0,4,0"/>
                                    <TextBlock Text="탐색 경로"/>
                                </StackPanel>
                            </Button>

                            <Button Click="OpenBackupHistory_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📜" Margin="0,0,4,0"/>
                                    <TextBlock Text="백업 이력"/>
                                </StackPanel>
                            </Button>

                            <Button Click="OpenActivityLog_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝" Margin="0,0,4,0"/>
                                    <TextBlock Text="작업 로그"/>
                                </StackPanel>
                            </Button>

                            <Button Click="OpenSecurityGuide_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" Margin="0,0,4,0"/>
                                    <TextBlock Text="보안 수칙"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CheckUpdatesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" ToolTip="GitHub 최신 릴리스 및 버전 수동 확인">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✨" Margin="0,0,4,0"/>
                                    <TextBlock Text="업데이트 확인"/>
                                </StackPanel>
                            </Button>

                            <Button Click="OpenAbout_Click" Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ️" Margin="0,0,4,0"/>
                                    <TextBlock Text="정보"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Integrated Window Controls (ALWAYS VISIBLE, ANCHORED IN DEDICATED COLUMN 2) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,0,0">
                    <!-- Divider before Window Caption Buttons -->
                    <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="2,0,8,0" VerticalAlignment="Center"/>

                    <!-- Integrated Window Control Buttons (Minimize / Maximize / Close) -->
                    <Button Click="MinimizeWindow_Click" Style="{StaticResource TitleBarButton}" ToolTip="최소화" Margin="0,0,2,0">
                        <TextBlock Text="─" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Button Click="MaximizeRestoreWindow_Click" Style="{StaticResource TitleBarButton}" ToolTip="최대화 / 복원" Margin="0,0,2,0">
                        <TextBlock x:Name="TxtMaxRestoreIcon" Text="□" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Button Click="CloseWindow_Click" Style="{StaticResource TitleBarCloseButton}" ToolTip="종료">
                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14">
                <DockPanel>
                    <!-- Bottom Info & Target Drive -->
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,16,0,0">
                        <!-- Target USB / Disk Drive Selector -->
                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="복사 / 백업 대상 드라이브" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding AvailableTargetDrives}" SelectedItem="{Binding SelectedTargetDrive}"
                                          DisplayMemberPath="DisplayName" Height="32" FontSize="12" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedTargetDrive.FormattedFreeSpace, TargetNullValue='(사용 가능한 드라이브 없음)', FallbackValue='(사용 가능한 드라이브 없음)'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Local Isolation Box -->
                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="8" Padding="10" BorderBrush="#10B981" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                                    <TextBlock Text="로컬 샌드박스 격리" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                                <TextBlock Text="인터넷 전송 없음 · 100% 로컬 암호화" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Company & Author Footer -->
                        <StackPanel Margin="2,0,2,0">
                            <TextBlock Text="저작권: AhBiYout" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Filter Navigation List -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="인증서 카테고리" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,0,8"/>

                        <RadioButton GroupName="Filters" IsChecked="True" Click="Filter_Click" Tag="ALL"
                                     Style="{StaticResource SidebarNavRadio}">
                            <Grid Width="210">
                                <TextBlock Text="전체 인증서" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalCount}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton GroupName="Filters" Click="Filter_Click" Tag="GPKI"
                                     Style="{StaticResource SidebarNavRadio}">
                            <Grid Width="210">
                                <TextBlock Text="GPKI (행정전자서명)" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GpkiCount}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton GroupName="Filters" Click="Filter_Click" Tag="EPKI"
                                     Style="{StaticResource SidebarNavRadio}">
                            <Grid Width="210">
                                <TextBlock Text="EPKI (교육기관서명)" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EpkiCount}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton GroupName="Filters" Click="Filter_Click" Tag="NPKI"
                                     Style="{StaticResource SidebarNavRadio}">
                            <Grid Width="210">
                                <TextBlock Text="NPKI (금융/공동)" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NpkiCount}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton GroupName="Filters" Click="Filter_Click" Tag="EXPIRED"
                                     Style="{StaticResource SidebarNavRadio}">
                            <Grid Width="210">
                                <TextBlock Text="만료된 인증서" VerticalAlignment="Center" Foreground="#E11D48"/>
                                <TextBlock Text="{Binding ExpiredCount}" HorizontalAlignment="Right" Foreground="#E11D48" FontWeight="Bold"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton GroupName="Filters" Click="Filter_Click" Tag="CUSTOM_PATH"
                                     Style="{StaticResource SidebarNavRadio}">
                            <Grid Width="210">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚠️ " FontSize="12"/>
                                    <TextBlock Text="비표준 위치 인증서" VerticalAlignment="Center" Foreground="#D97706"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CustomPathCount}" HorizontalAlignment="Right" Foreground="#D97706" FontWeight="Bold"/>
                            </Grid>
                        </RadioButton>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="4,10,4,10"/>
                        <TextBlock Text="저장 매체 구분 (USB / PC)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,0,8"/>

                        <RadioButton GroupName="Filters" Click="Filter_Click" Tag="PC"
                                     Style="{StaticResource SidebarNavRadio}">
                            <Grid Width="210">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💻 " FontSize="12"/>
                                    <TextBlock Text="컴퓨터 (로컬 보관함)" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ComputerCount}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton GroupName="Filters" Click="Filter_Click" Tag="USB"
                                     Style="{StaticResource SidebarNavRadio}">
                            <Grid Width="210">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💾 " FontSize="12"/>
                                    <TextBlock Text="USB (이동식 저장소)" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding UsbCount}" HorizontalAlignment="Right" Foreground="#059669" FontWeight="Bold"/>
                            </Grid>
                        </RadioButton>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="4,14,4,10"/>
                        <TextBlock Text="인증서 서비스 센터" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,0,8"/>

                        <Button Click="OpenRenewalGuidance_Click" Style="{StaticResource PrimaryButton}" Height="38" Margin="4,0,4,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🌐 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="인증서 갱신 안내" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Top Stats & Quick Clean/Undo/Zip Tools -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="인증서 보관함 목록" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                        <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="10,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="{Binding FilteredCertificates.Count, StringFormat='{}표시 중: {0}개'}" FontSize="12" Foreground="#60A5FA"/>
                        </Border>
                        <TextBlock Text="(항목 더블클릭 시 상세 규격 및 지문 조회)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Quick Tools -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding UndoDeleteCommand}" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                Background="#D97706" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↩️" Margin="0,0,4,0"/>
                                <TextBlock Text="삭제 취소(되돌리기)"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ToggleCertificateDetailSidebarCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                ToolTip="인증서의 모든 규격, 정책 OID, 일련번호, 지문을 가로/세로 스크롤로 확인하는 사이드바를 열거나 닫습니다.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📑" Margin="0,0,4,0"/>
                                <TextBlock Text="상세 사이드바"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CleanExpiredCommand}" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" Margin="0,0,4,0"/>
                                <TextBlock Text="만료 인증서 정리"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1 (Simple Mode): Clean 1-Line Quick Action Banner -->
                <Border Grid.Row="1" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ 간편 백업" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="복사 대상: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="8,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💾 " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedTargetDrive.DisplayName, TargetNullValue='(연결된 USB 없음)', FallbackValue='(연결된 USB 없음)'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding SelectedTargetDrive.FormattedFreeSpace}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding BackupAllCommand}" Style="{StaticResource SuccessButton}" Padding="12,6" Margin="0,0,8,0" ToolTip="전체 인증서를 선택된 대상 드라이브로 즉시 원클릭 일괄 복사합니다.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,5,0"/>
                                    <TextBlock Text="원클릭 전체 복사" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OpenUsbTransfer_Click" Style="{StaticResource SecondaryButton}" Padding="12,6" ToolTip="USB에 있는 인증서를 PC로 안전하게 복사해 넣습니다.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" Margin="0,0,5,0"/>
                                    <TextBlock Text="USB ➔ PC 넣기" Foreground="#10B981" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1 (Advanced Mode): Connected Drives Hardware Diagnostic Bar (Shows USB and Internal NVMe/SATA Drives with Basic/Advanced View Modes) -->
                <Border Grid.Row="1" Visibility="{Binding IsAdvancedUIMode, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with count & mode switch controls -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾 연결된 드라이브 현황" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,8,0"/>
                                <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="10" Padding="8,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding DisplayedStatusDrives.Count, StringFormat='{}총 {0}개 감지됨'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Scope Switch: USB Only vs All Drives (Internal NVMe/SATA + USB) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="DriveScopeGroup" Content="USB 백업 드라이브" IsChecked="{Binding ShowOnlyUsbDrivesInStatus, Mode=TwoWay}"
                                                     Style="{StaticResource ModeToggleRadio}"/>
                                        <RadioButton GroupName="DriveScopeGroup" Content="PC 내부(NVMe/SATA) 포함 전체" IsChecked="{Binding ShowAllDrivesInStatus, Mode=TwoWay}"
                                                     Style="{StaticResource ModeToggleRadio}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Basic / Advanced Display Mode Switch -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="표시 방식:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="DisplayModeGroup" Content="기본 표시" IsChecked="{Binding IsDriveBasicMode, Mode=TwoWay}"
                                                     Style="{StaticResource ModeToggleRadio}"/>
                                        <RadioButton GroupName="DisplayModeGroup" Content="고급 표시" IsChecked="{Binding IsDriveAdvancedMode, Mode=TwoWay}"
                                                     Style="{StaticResource ModeToggleRadio}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Drives Cards List -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DisplayedStatusDrives}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,10,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinWidth="270">
                                        <Grid>
                                            <!-- BASIC VIEW MODE (when IsDriveAdvancedMode is False) -->
                                            <Grid Visibility="{Binding DataContext.IsDriveAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding VolumeLabel, StringFormat='{}[{0}]'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <!-- Storage Port Tag -->
                                                        <Border Background="#1E3A8A" CornerRadius="3" Padding="4,1">
                                                            <TextBlock Text="{Binding PhysicalPortDetail}" FontSize="9" Foreground="#93C5FD" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FormattedFreeSpace}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    
                                                    <!-- Status Badge -->
                                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#064E3B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEmptyUsb}" Value="True">
                                                                        <Setter Property="Background" Value="#78350F"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#6EE7B7"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEmptyUsb}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FDE68A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Quick Backup button -->
                                                <Button Grid.Column="1" 
                                                        Command="{Binding DataContext.QuickBackupToDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}" 
                                                        Padding="8,4" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚡" Margin="0,0,4,0"/>
                                                        <TextBlock Text="백업"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- ADVANCED VIEW MODE (when IsDriveAdvancedMode is True) -->
                                            <Grid Visibility="{Binding DataContext.IsDriveAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" MinWidth="310">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Hardware Header & Badges -->
                                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding VolumeLabel, StringFormat='{}[{0}]'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Hardware Port Badge: NVMe vs SATA vs USB and SSD vs HDD -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border CornerRadius="4" Padding="6,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1E3A8A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNvme}" Value="True">
                                                                            <Setter Property="Background" Value="#1D4ED8"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSata}" Value="True">
                                                                            <Setter Property="Background" Value="#0F766E"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsHdd}" Value="True">
                                                                            <Setter Property="Background" Value="#C2410C"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding PhysicalPortDetail}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Physical Model name -->
                                                <TextBlock Grid.Row="1" Text="{Binding PhysicalModel, StringFormat='{}하드웨어: {0}'}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>

                                                <!-- Bus & File System info -->
                                                <Grid Grid.Row="2" Margin="0,2,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding BusType, StringFormat='{}포트: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FileSystem, StringFormat='{}포맷: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <!-- Capacity & Action -->
                                                <Grid Grid.Row="3" Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedFreeSpace}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" 
                                                            Command="{Binding DataContext.QuickBackupToDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButton}" 
                                                            Padding="8,4" FontSize="11" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⚡" Margin="0,0,4,0"/>
                                                            <TextBlock Text="백업"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Row 2: DataGrid Certificate List & Certificate Details Sidebar (With Horizontal & Vertical Scrollbars) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColDataGrid" Width="*" MinWidth="380"/>
                        <ColumnDefinition x:Name="ColSplitter" Width="Auto">
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="Auto"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCertificateDetailSidebarVisible}" Value="False">
                                            <Setter Property="Width" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition x:Name="ColDetailSidebar">
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="410"/>
                                    <Setter Property="MinWidth" Value="300"/>
                                    <Setter Property="MaxWidth" Value="680"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCertificateDetailSidebarVisible}" Value="False">
                                            <Setter Property="Width" Value="0"/>
                                            <Setter Property="MinWidth" Value="0"/>
                                            <Setter Property="MaxWidth" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: Main Certificate DataGrid (With Native Horizontal & Vertical Scrollbars) -->
                    <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <DataGrid x:Name="CertDataGrid" 
                                  ItemsSource="{Binding FilteredCertificates}" 
                                  SelectedItem="{Binding SelectedCertificate, Mode=TwoWay}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  IsReadOnly="True" 
                                  SelectionMode="Single"
                                  SelectionChanged="CertDataGrid_SelectionChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="False"
                                  PreviewMouseWheel="CertListHorizontalScrollViewer_PreviewMouseWheel"
                                      GridLinesVisibility="Horizontal" 
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}" 
                                      Background="{DynamicResource BgCardBrush}" 
                                      RowBackground="{DynamicResource BgCardBrush}" 
                                      AlternatingRowBackground="{DynamicResource BgDarkBrush}" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" 
                                      BorderThickness="0" 
                                      HeadersVisibility="Column"
                                      MinRowHeight="46"
                                      RowHeight="48"
                                      MouseDoubleClick="CertDataGrid_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="CertDataGrid_PreviewMouseRightButtonDown"
                                      Sorting="CertDataGrid_Sorting">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                    <MenuItem Header="💾 대상 디스크 선택 및 복사... (Target Drive Picker)" Click="ContextMenuCopy_Click" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Separator Background="{DynamicResource BorderBrush}"/>
                                    <MenuItem Header="🔍 인증서 상세 정보" Click="ContextMenuDetail_Click" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <MenuItem Header="📋 전체 경로 클립보드 복사" Click="ContextMenuCopyPath_Click" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Separator Background="{DynamicResource BorderBrush}"/>
                                    <MenuItem Header="🗑️ 휴지통으로 안전 삭제" Click="ContextMenuDelete_Click" Foreground="#F87171"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Resources>
                                <!-- Subtle navy highlight brushes for clean, organized row selection without blinding blue fill -->
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#172554"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E2E8F0"/>

                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource BgDarkBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                             <ControlTemplate TargetType="DataGridCell">
                                                 <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                                                     <ContentPresenter VerticalAlignment="Center"/>
                                                 </Border>
                                             </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecentlyCopied}" Value="True">
                                            <Setter Property="Background" Value="#065F46"/>
                                            <Setter Property="Foreground" Value="#E6FFFA"/>
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1E3A8A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <!-- Selection Checkbox -->
                                <DataGridTemplateColumn Width="45" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Category Badge -->
                                <DataGridTemplateColumn Header="구분" Width="125" SortMemberPath="CategoryBadgeText" CanUserSort="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding CategoryBadgeText}" FontSize="11" Foreground="#93C5FD" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Storage Location Badge [USB/컴퓨터 with distinct drive colors C, D, E, F, G, H, I, J...] -->
                                <DataGridTemplateColumn Header="저장 위치" Width="135" SortMemberPath="StorageLocationBadge" CanUserSort="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="5" Padding="7,3" HorizontalAlignment="Left"
                                                    Background="{Binding StorageLocationBgColorHex}"
                                                    BorderBrush="{Binding StorageLocationBorderColorHex}"
                                                    BorderThickness="1"
                                                    ToolTip="{Binding LocationNoticeText}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StorageLocationIcon}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="{Binding StorageLocationType}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Border Background="{Binding StorageLocationTagBgHex}" CornerRadius="3" Padding="4,1"
                                                            BorderBrush="{Binding StorageLocationBorderColorHex}" BorderThickness="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DriveLetter}" FontSize="10" FontWeight="ExtraBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- CN / Name -->
                                <DataGridTemplateColumn Header="인증서 명칭 (CN) 및 경로 상태" Width="640" MinWidth="520" SortMemberPath="CommonName" CanUserSort="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CommonName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,6,0"/>
                                                    <!-- Non-Standard Path Badge -->
                                                    <Border Visibility="{Binding IsCustomPath, Converter={StaticResource BoolToVis}}" 
                                                            Background="#78350F" BorderBrush="#D97706" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                                            ToolTip="{Binding LocationNoticeText}">
                                                        <TextBlock Text="⚠️ 비표준 위치 (미인식)" FontSize="10" Foreground="#FDE68A" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DirectoryPath}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" MaxHeight="16" ToolTip="{Binding DirectoryPath}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Issuer -->
                                <DataGridTemplateColumn Header="발급기관" Width="175" SortMemberPath="IssuerName" CanUserSort="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IssuerName}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Expiration Date -->
                                <DataGridTemplateColumn Header="만료일자" Width="110" SortMemberPath="NotAfter" CanUserSort="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NotAfter, StringFormat='{}{0:yyyy-MM-dd}'}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Status -->
                                <DataGridTemplateColumn Header="상태" Width="120" SortMemberPath="StatusDisplayText" CanUserSort="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#064E3B"/>
                                                        <Setter Property="BorderBrush" Value="#059669"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                                <Setter Property="Background" Value="#881337"/>
                                                                <Setter Property="BorderBrush" Value="#E11D48"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="ExpiringSoon">
                                                                <Setter Property="Background" Value="#78350F"/>
                                                                <Setter Property="BorderBrush" Value="#D97706"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusDisplayText}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#34D399"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="ExpiringSoon">
                                                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Key Status -->
                                <DataGridTemplateColumn Header="비밀키" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="🔑 보유" FontSize="11" Foreground="#10B981" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Quick Action Buttons: 복사 & 상세보기 -->
                                <DataGridTemplateColumn Header="작업 / 복사" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="💾 복사" Style="{StaticResource PrimaryButton}" Padding="7,2" Margin="0,0,5,0" Click="BtnRowCopy_Click" ToolTip="이 인증서의 복사 대상 디스크(USB · 로컬 디스크) 선택 팝업을 열고 복사합니다."/>
                                                <Button Content="🔍 상세" Style="{StaticResource SecondaryButton}" Padding="7,2" Click="BtnRowDetail_Click" ToolTip="인증서 세부 정보를 확인합니다."/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Column 1: Resizable Splitter between Table and Detail Sidebar (가로 구분 사이드바) -->
                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="Transparent" Cursor="SizeWE" Margin="1,0"
                                  ToolTip="드래그하여 테이블과 상세 정보 사이드바의 너비를 조절할 수 있습니다."
                                  Visibility="{Binding IsCertificateDetailSidebarVisible, Converter={StaticResource BoolToVis}}">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="Transparent" Width="8" HorizontalAlignment="Center">
                                    <Border Width="2" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" CornerRadius="1"/>
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Column 2: Certificate Full Details Sidebar (With Dedicated Horizontal & Vertical Scrollbars) -->
                    <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding IsCertificateDetailSidebarVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Sidebar Header -->
                            <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" CornerRadius="8,8,0,0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📑" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="인증서 상세 내용" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding CopySelectedCertDetailsCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" ToolTip="인증서의 전체 상세 텍스트를 클립보드에 복사합니다.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📋" Margin="0,0,3,0"/>
                                                <TextBlock Text="전체 복사" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding CloseCertificateDetailSidebarCommand}" Style="{StaticResource SecondaryButton}" Padding="7,3" Content="✕" ToolTip="사이드바 닫기"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Scrollable Content with Horizontal and Vertical Scrollbars -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="14,12">
                                <Grid>
                                    <!-- If Certificate Selected -->
                                    <StackPanel Visibility="{Binding SelectedCertificate, Converter={StaticResource NotNullToVis}}">
                                        <!-- 1. Top Certificate Card Header -->
                                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SelectedCertificate.CategoryBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                                                    </Border>
                                                    <Border CornerRadius="4" Padding="6,2"
                                                            Background="{Binding SelectedCertificate.StorageLocationBgColorHex}"
                                                            BorderBrush="{Binding SelectedCertificate.StorageLocationBorderColorHex}" BorderThickness="1">
                                                        <TextBlock Text="{Binding SelectedCertificate.StorageLocationBadge}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding SelectedCertificate.CommonName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                                <!-- Status Tag & Countdown -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SelectedCertificate.StatusDisplayText}" FontSize="11.5" FontWeight="Bold" Foreground="#34D399"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectedCertificate.RemainingDays, StringFormat='{}만료까지 {0}일'}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. Detailed Specs Grid (소유자, 발급자, 일련번호 등) -->
                                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="📋 소유자 및 발급자 식별 정보" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,10"/>

                                                <!-- Common Name -->
                                                <TextBlock Text="인증서 명칭 (CN):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedCertificate.CommonName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>

                                                <!-- Issuer -->
                                                <TextBlock Text="발급기관 (Issuer):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedCertificate.IssuerName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>

                                                <!-- Subject DN with Copy Button -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="소유자 전체 식별명 (User DN):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding SelectedCertificate.SubjectDn}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Click="CopyField_Click" Tag="{Binding SelectedCertificate.SubjectDn}" Style="{StaticResource SecondaryButton}" Padding="6,2" VerticalAlignment="Top" ToolTip="소유자 DN 복사">
                                                        <TextBlock Text="📋 복사" FontSize="10.5"/>
                                                    </Button>
                                                </Grid>

                                                <!-- Serial Number with Copy Button -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="일련번호 (Serial Number):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding SelectedCertificate.SerialNumber}" FontSize="11" FontFamily="Consolas" Foreground="#38BDF8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Click="CopyField_Click" Tag="{Binding SelectedCertificate.SerialNumber}" Style="{StaticResource SecondaryButton}" Padding="6,2" VerticalAlignment="Top" ToolTip="일련번호 복사">
                                                        <TextBlock Text="📋 복사" FontSize="10.5"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. Validity Period -->
                                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="⏳ 유효기간 현황" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="발급 일자:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding SelectedCertificate.NotBefore, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="만료 일자:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding SelectedCertificate.NotAfter, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11.5" FontWeight="Bold" Foreground="#F43F5E" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 4. Security & Cryptographic Specs -->
                                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="🛡️ 암호화 규격 및 정책" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,10"/>

                                                <TextBlock Text="전자서명 알고리즘:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedCertificate.SignatureAlgorithm}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,8"/>

                                                <!-- Policy OID -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="정책 OID 및 용도:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding SelectedCertificate.PolicyOid}" FontSize="11" FontFamily="Consolas" Foreground="#A78BFA" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding SelectedCertificate.PolicyUsage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Click="CopyField_Click" Tag="{Binding SelectedCertificate.PolicyOid}" Style="{StaticResource SecondaryButton}" Padding="6,2" VerticalAlignment="Top" ToolTip="정책 OID 복사">
                                                        <TextBlock Text="📋 복사" FontSize="10.5"/>
                                                    </Button>
                                                </Grid>

                                                <!-- Key status -->
                                                <TextBlock Text="개인키(signPri.key) 상태:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="🔑 개인키 보유 완료 (정상 페어 무결성 통과)" FontSize="11.5" FontWeight="SemiBold" Foreground="#10B981"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 5. Storage Directory & Files -->
                                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="📁 저장 경로 및 보관 상태" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,10"/>

                                                <!-- Standard Location Badge -->
                                                <Border CornerRadius="4" Padding="6,3" Margin="0,0,0,8" HorizontalAlignment="Left"
                                                        Background="#1E293B" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding SelectedCertificate.StandardLocationBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>

                                                <!-- Full Directory Path with Copy & Open Buttons -->
                                                <TextBlock Text="폴더 전체 경로:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedCertificate.DirectoryPath}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Button Click="CopyField_Click" Tag="{Binding SelectedCertificate.DirectoryPath}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📋" Margin="0,0,4,0"/>
                                                            <TextBlock Text="경로 복사" FontSize="11"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{Binding OpenSelectedCertDirectoryCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📂" Margin="0,0,4,0"/>
                                                            <TextBlock Text="폴더 열기" FontSize="11"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>

                                                <!-- File details -->
                                                <TextBlock Text="인증서 파일 (signCert.der):" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedCertificate.DerFileSize, StringFormat='{}{0:N0} bytes'}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,1,0,4"/>

                                                <TextBlock Text="개인키 파일 (signPri.key):" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedCertificate.KeyFileSize, StringFormat='{}{0:N0} bytes'}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 6. Quick Action Buttons inside Sidebar -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                            <Button Click="ContextMenuCopy_Click" Style="{StaticResource PrimaryButton}" Padding="12,8" Margin="0,0,8,0" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💾" Margin="0,0,5,0"/>
                                                    <TextBlock Text="이 인증서 복사" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Click="ContextMenuDetail_Click" Style="{StaticResource SecondaryButton}" Padding="12,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔍" Margin="0,0,5,0"/>
                                                    <TextBlock Text="전문 규격 팝업"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- If NO Certificate Selected -->
                                    <StackPanel Visibility="{Binding SelectedCertificate, Converter={StaticResource NullToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
                                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <TextBlock Text="인증서를 선택하세요" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="목록에서 인증서를 클릭하시면&#x0a;모든 상세 규격, 정책 OID, 일련번호가&#x0a;가로/세로 스크롤로 실시간 표시됩니다."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 3: Bottom Action Controls (Includes USB ➔ PC 넣기 at the bottom) -->
                <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="0,14,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selection actions & USB to PC Import button -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Prominent USB ➔ PC 넣기 button placed at bottom -->
                            <Button Click="OpenUsbTransfer_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" Margin="0,0,6,0" FontSize="13"/>
                                    <TextBlock Text="USB ➔ PC 넣기" Foreground="#10B981" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Click="SelectAll_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Content="전체 선택"/>
                            <Button Click="DeselectAll_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Content="선택 해제"/>
                            <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource SecondaryButton}" Foreground="#E11D48" Margin="0,0,8,0" Content="선택 항목 일괄 삭제"/>
                            <Button Command="{Binding UndoDeleteCommand}" Style="{StaticResource SecondaryButton}" Foreground="#059669" Margin="0,0,8,0" Content="↩ 삭제 취소" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"/>
                            <Button Command="{Binding CleanExpiredCommand}" Style="{StaticResource SecondaryButton}" Foreground="#D97706" Margin="0,0,8,0" Content="🧹 만료 정리"/>
                        </StackPanel>

                        <!-- Main Backup execution buttons (Supports Disk->Disk, USB->USB, Disk->USB, USB->Disk) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="BackupSelected_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    ToolTip="복사 목적지 디스크(USB 메모리 또는 로컬 디스크)를 지정하는 팝업창을 띄우고 선택한 인증서를 복사합니다.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" Margin="0,0,6,0"/>
                                    <TextBlock Text="선택 인증서 복사 / 백업"/>
                                </StackPanel>
                            </Button>

                            <Button Click="BackupAll_Click" Style="{StaticResource SuccessButton}"
                                    ToolTip="복사 목적지 디스크(USB 메모리 또는 로컬 디스크)를 지정하는 팝업창을 띄우고 전체 인증서를 일괄 복사합니다.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,6,0"/>
                                    <TextBlock Text="전체 일괄 복사 / 백업"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppVersion, TargetNullValue='v1.6.4', FallbackValue='v1.6.4'}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RuntimeInfo}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </Border>
                    <TextBlock Text="|" FontSize="11" Foreground="{DynamicResource BorderBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Developer: AhBiYout  |  " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Hyperlink NavigateUri="http://www.cisnet.co.kr/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#38BDF8">
                            홈페이지
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="  |  " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Hyperlink NavigateUri="https://ahbiyoutvibe.blogspot.com/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#34D399">
                            블로그
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="  |  " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Hyperlink NavigateUri="https://github.com/ahbiyout-all/K-Certificate-Manager" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#818CF8">
                            GitHub
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Guided Workflow Overlay Banner -->
        <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Panel.ZIndex="90"
                Margin="16,10,16,0" Background="#0F172A" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="10" Padding="14,10"
                Visibility="{Binding IsGuidedWorkflowActive, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E3A8A" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="{Binding GuidedWorkflowTitle}" FontSize="12" FontWeight="Bold" Foreground="#60A5FA"/>
                    </Border>
                    <TextBlock Text="{Binding GuidedWorkflowStepTitle}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding GuidedWorkflowStepDescription}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PrevGuidedStepCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Content="◀ 이전"/>
                    <Button Command="{Binding GuidedExecuteCopyCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,6,0" Content="⚡ 대상 USB로 복사 시작"/>
                    <Button Command="{Binding NextGuidedStepCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Content="다음 단계 ➔"/>
                    <Button Command="{Binding EndGuidedWorkflowCommand}" Style="{StaticResource SecondaryButton}" Content="가이드 종료 ✕"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Floating Interactive Toast Notification Bar with SHA-256 Integrity Badge & File Size/Path Info -->
        <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" Panel.ZIndex="100"
                Margin="0,16,24,0" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="10" Padding="16,12"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ToastMessage}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    
                    <!-- Integrity Badge -->
                    <Border Visibility="{Binding ToastHasIntegrityBadge, Converter={StaticResource BoolToVis}}"
                            Background="#065F46" BorderBrush="#34D399" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="무결성 확인 완료 (SHA-256)" FontSize="11" FontWeight="Bold" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding CloseToastCommand}" Style="{StaticResource SecondaryButton}" Padding="6,2" Content="✕" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Detailed File Path & Size Subtext -->
                <StackPanel Margin="24,6,0,0" Visibility="{Binding ToastFilePath, Converter={StaticResource NotNullToVis}}">
                    <TextBlock Text="{Binding ToastFilePath, StringFormat='📂 저장 경로: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#38BDF8"/>
                    <TextBlock Text="{Binding ToastFileSize, StringFormat='📊 파일 크기: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
