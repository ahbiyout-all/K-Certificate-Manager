<Window x:Class="KCertManager.Wpf.Views.UsbTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KCertManager.Wpf.ViewModels"
        Title="USB ➔ 내 컴퓨터로 인증서 가져오기" 
        Height="540" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDarkBrush}">

    <Window.DataContext>
        <vm:UsbTransferViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="📥" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="USB ➔ 내 컴퓨터(PC) 인증서 가져오기" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="USB 이동식 메모리에 저장된 GPKI / NPKI 인증서를 PC의 안전한 로컬 보관함으로 복사합니다." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Source Drive Selection -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="가져올 드라이브 (USB · 디스크):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedSourceDrive}"
                          DisplayMemberPath="DisplayName" Height="30" FontSize="12" Margin="0,0,12,0"/>
                <Button Grid.Column="2" Command="{Binding RefreshDrivesCommand}" Style="{StaticResource SecondaryButton}" Content="🔄 드라이브 갱신"/>
            </Grid>
        </Border>

        <!-- USB Cert List -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <DataGrid ItemsSource="{Binding FoundUsbCertificates}" AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="Transparent" RowBackground="{DynamicResource BgCardBrush}" AlternatingRowBackground="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="선택" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                    <DataGridTextColumn Header="구분" Binding="{Binding CategoryBadgeText}" Width="110" Foreground="{DynamicResource AccentTextBrush}"/>
                    <DataGridTextColumn Header="인증서 명칭 (CN)" Binding="{Binding CommonName}" Width="*" FontWeight="Bold"/>
                    <DataGridTextColumn Header="발급기관" Binding="{Binding IssuerName}" Width="130" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <DataGridTextColumn Header="만료일" Binding="{Binding NotAfter, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Action buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="Close_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Content="닫기"/>
                <Button Command="{Binding TransferToPcCommand}" Style="{StaticResource SuccessButton}" Padding="16,8" Content="내 PC로 가져오기 시작"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
