<Window x:Class="KCertManager.Wpf.Views.SearchLocationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="탐색 경로 및 사용자 지정 폴더 관리 (Search Locations Manager)"
        Width="750" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" Background="#1E3A8A" CornerRadius="8" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="인증서 탐색 경로 및 사용자 폴더 설정" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="표준 NPKI, GPKI, EPKI 경로 외에 백업 폴더나 보조 드라이브를 추가하여 동시에 검색할 수 있습니다." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="➕ 폴더 추가" Style="{StaticResource SuccessButton}" Click="BtnAddFolder_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Search Paths DataGrid -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="2" BorderBrush="#334155" BorderThickness="1">
            <DataGrid x:Name="GridPaths"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      Background="#1E293B"
                      RowBackground="#1E293B"
                      AlternatingRowBackground="#0F172A"
                      Foreground="#F8FAFC"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#334155"
                      HeadersVisibility="Column"
                      RowHeight="44">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#F8FAFC"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="활성" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                    <DataGridTextColumn Header="구분" Binding="{Binding Name}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="탐색 디렉터리 경로" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="100" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="삭제" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Style="{StaticResource SecondaryButton}" Padding="6,2" Click="BtnDeleteCustomPath_Click" IsEnabled="{Binding IsCustom}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,16,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <TextBlock Text="체크된 경로들만 전체 스캔 시 탐색 대상에 포함됩니다." Foreground="#94A3B8" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="기본값으로 복원" Style="{StaticResource SecondaryButton}" Click="BtnResetDefaults_Click" Margin="0,0,8,0"/>
                    <Button Content="적용 및 재스캔" Style="{StaticResource PrimaryButton}" Click="BtnApplyAndScan_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
