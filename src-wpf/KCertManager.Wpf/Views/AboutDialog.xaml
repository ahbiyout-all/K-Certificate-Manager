<Window x:Class="KCertManager.Wpf.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K-Certificate Manager 정보 및 라이선스 (Korean / English License)" 
        Height="640" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Brand & Language Toggle -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border CornerRadius="8" Width="42" Height="42" Margin="0,0,12,0" ClipToBounds="True" Background="Transparent">
                    <Image Source="/Assets/app-logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform" 
                           Width="40" Height="40"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="K-Certificate Manager (K-인증서 매니저)" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="C# WPF MVVM Desktop Edition v1.4.5 · 한국어 / English 2종 라이선스" FontSize="11.5" Foreground="#93C5FD"/>
                </StackPanel>
            </StackPanel>

            <!-- Language Switcher Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnLangBoth" Click="BtnLangBoth_Click" Content="한·영 통합" Padding="10,5" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="BtnLangKr" Click="BtnLangKr_Click" Content="한국어 (KR)" Padding="10,5" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#475569" BorderThickness="1" Cursor="Hand"/>
                <Button x:Name="BtnLangEn" Click="BtnLangEn_Click" Content="English (EN)" Padding="10,5" FontSize="11" FontWeight="Bold" Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#475569" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Copyright & Quick Summary Bar -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12,10" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Copyright (c) 2026 AhBiYout (https://ahbiyoutvibe.blogspot.com/). All rights reserved." FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Company: CISNet (http://www.cisnet.co.kr/) | GitHub: https://github.com/ahbiyout-all/K-Certificate-Manager" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnCopyLicense" Grid.Column="1" Click="BtnCopyLicense_Click" Content="📋 라이선스 복사" Padding="10,5" FontSize="11" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Scrollable Dual License Content (Korean & English) -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. Korean License Definition Panel -->
                    <Border x:Name="PanelLicenseKr" Background="#0F172A" CornerRadius="6" Padding="14" BorderBrush="#1D4ED8" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🇰🇷 [한국어 라이선스 정의] K-인증서 매니저 소프트웨어 라이선스 계약서 (LICENSE_KR.txt)" FontSize="12.5" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                            <TextBlock Text="본 소프트웨어는 대한민국 공무원, 교직원, 금융 이용자 및 기업 사용자의 공인/공동인증서(GPKI, EPKI, NPKI) 관리 및 안전한 이동을 위해 무료(Free License)로 제공됩니다." FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="• 제 1 조 (사용 허가 및 권한)" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,2"/>
                            <TextBlock Text="  개인, 공공기관, 교육기관, 비영리단체 및 영리 기업을 포함한 모든 사용자에게 영구 무료로 배포되며, 자유로운 복제·설치·실행 및 배포가 허가됩니다. 저작권 표기(AhBiYout)는 수정하거나 삭제할 수 없습니다." FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock Text="• 제 2 조 (보안 및 개인정보 보호 보장)" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,2"/>
                            <TextBlock Text="  100% 순수 오프라인 로컬 환경에서 구동되며, 사용자의 인증서 파일(signCert.der, signPri.key), 비밀번호 및 개인정보를 외부 서버로 전송하거나 수집하지 않습니다 (Zero-Network / Zero-Telemetry)." FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock Text="• 제 3 조 (오픈소스 소프트웨어 고지)" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,2"/>
                            <TextBlock Text="  .NET / WPF Runtime (MIT), React 19 (MIT), Vite 6 (MIT), Tailwind CSS (MIT), Lucide Icons (ISC), JSZip (MIT) 등 오픈소스 라이선스 조항을 준수합니다." FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock Text="• 제 4 조 (보증의 부인 및 책임의 한계)" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,2"/>
                            <TextBlock Text="  본 소프트웨어는 '있는 그대로(AS-IS)' 제공되며, 사용으로 인해 발생하는 직·간접적 손해에 대해 법적 책임을 지지 않습니다. 중요 인증서는 작업 전 반드시 안전하게 백업하시기 바랍니다." FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. English License Definition Panel -->
                    <Border x:Name="PanelLicenseEn" Background="#0F172A" CornerRadius="6" Padding="14" BorderBrush="#4F46E5" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🇺🇸 [English License Definition] K-Certificate Manager Software License Agreement (LICENSE_EN.txt)" FontSize="12.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8"/>
                            <TextBlock Text="This software is provided free of charge (Free License) for civil servants, educators, financial users, and enterprise professionals to safely manage and transfer Accredited/Joint Digital Certificates (GPKI, EPKI, NPKI)." FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="• Article 1 (Grant of License and Permissions)" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC" Margin="0,0,0,2"/>
                            <TextBlock Text="  Permanently distributed free of charge to all users—including individuals, government/public agencies, schools, non-profits, and commercial enterprises—with full permission to copy, install, execute, and distribute. The copyright notice (AhBiYout) may not be altered or removed." FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock Text="• Article 2 (Security and Privacy Protection Guarantee)" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,2"/>
                            <TextBlock Text="  Engineered to operate in a 100% offline local environment. It never transmits or collects certificate files (signCert.der, signPri.key), passwords, or personal data to any external server (Zero-Network / Zero-Telemetry)." FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock Text="• Article 3 (Open Source Software Notice)" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC" Margin="0,0,0,2"/>
                            <TextBlock Text="  Complies with open source licenses including .NET / WPF Runtime (MIT), React 19 (MIT), Vite 6 (MIT), Tailwind CSS (MIT), Lucide Icons (ISC), and JSZip (MIT)." FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock Text="• Article 4 (Disclaimer of Warranty and Limitation of Liability)" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,2"/>
                            <TextBlock Text="  THIS SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED. IN NO EVENT SHALL THE COPYRIGHT HOLDER OR DEVELOPER BE LIABLE FOR ANY CLAIM OR DAMAGES ARISING FROM THE USE OF THIS SOFTWARE." FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Developer & Official Links -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="개발자 및 공식 안내 (Developer &amp; Official Links)" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                            <TextBlock Text="• 개발자 (Developer): AhBiYout" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="• 소속 회사 (Company): " FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock FontSize="11">
                                    <Hyperlink NavigateUri="http://www.cisnet.co.kr/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#38BDF8">
                                        http://www.cisnet.co.kr/ (CISNet)
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="• 공식 블로그 (Blog): " FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock FontSize="11">
                                    <Hyperlink NavigateUri="https://ahbiyoutvibe.blogspot.com/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#34D399">
                                        https://ahbiyoutvibe.blogspot.com/
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="• GitHub 저장소 (Source &amp; Releases): " FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock FontSize="11">
                                    <Hyperlink NavigateUri="https://github.com/ahbiyout-all/K-Certificate-Manager" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#818CF8">
                                        https://github.com/ahbiyout-all/K-Certificate-Manager
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom Close Button -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="라이선스 정의: 한국어(LICENSE_KR.txt) 및 영어(LICENSE_EN.txt) 2종 지원" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Click="Close_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Content="확인 (Close)"/>
        </Grid>
    </Grid>
</Window>
