<Window x:Class="KCertManager.Wpf.Views.TrashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="삭제 보관함 (안전 휴지통)"
        Width="920" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" Background="#881337" CornerRadius="8" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🗑️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="삭제 보관함 (안전 휴지통)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="삭제한 인증서를 임시 보관하며, 복원 기록은 암호화 보호(AES-256 · DPAPI)로 안전하게 유지됩니다." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="2" Content="🔥 휴지통 비우기" Style="{StaticResource SecondaryButton}" Click="BtnEmptyTrash_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Tab Selector Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnTabDeleted" Content="🗑️ 삭제된 항목" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="BtnTabDeleted_Click" Margin="0,0,6,0" FontWeight="Bold"/>
            <Button x:Name="BtnTabRestored" Content="🔄 복원된 항목" Style="{StaticResource SecondaryButton}" Padding="14,7" Click="BtnTabRestored_Click" FontWeight="Bold"/>
        </StackPanel>

        <!-- Action Toolbar for Deleted Tab -->
        <Border x:Name="PanelDeletedToolbar" Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="☑️ 전체 선택" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="BtnSelectAll_Click" Margin="0,0,6,0"/>
                    <Button Content="선택 해제" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="BtnDeselectAll_Click" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtSelectedCount" Text="0개 선택됨" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRestoreSelected" Content="↩️ 선택 항목 복원" Style="{StaticResource SuccessButton}" Padding="12,5" Click="BtnRestoreSelected_Click" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button Content="↩️ 휴지통 전체 복원" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="BtnRestoreAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Toolbar for Restored Tab (Encrypted Vault Inspector & Tools) -->
        <Border x:Name="PanelRestoredToolbar" Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Search & Filter Controls -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Border Grid.Column="0" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox x:Name="TxtSearchRestored" Grid.Column="1" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" VerticalAlignment="Center" Padding="4,5" FontSize="11" TextChanged="TxtSearchRestored_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Category Filter -->
                    <ComboBox x:Name="CmbRestoredCategory" Grid.Column="1" Height="28" FontSize="11" SelectionChanged="CmbRestoredCategory_SelectionChanged" Margin="0,0,8,0">
                        <ComboBoxItem Content="전체 인증서" IsSelected="True"/>
                        <ComboBoxItem Content="은행·공동 인증서 (NPKI)"/>
                        <ComboBoxItem Content="공무원 인증서 (GPKI)"/>
                        <ComboBoxItem Content="교육기관 인증서 (EPKI)"/>
                    </ComboBox>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🔒 보안 점검" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="BtnVaultSelfTest_Click" Margin="0,0,6,0" ToolTip="암호화 보관 파일 손상 여부 검사"/>
                        <Button Content="📁 보관 폴더" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="BtnOpenVaultFolder_Click" Margin="0,0,6,0" ToolTip="암호화 보관 폴더 열기"/>
                        <Button Content="💾 백업 내보내기" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="BtnExportVaultBackup_Click" Margin="0,0,6,0" ToolTip="암호화된 복원 기록 백업 내보내기"/>
                        <Button Content="🧹 기록 비우기" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="BtnClearRestored_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Real-time Vault Security & Integrity Inspector Banner -->
                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="이중 암호화 보호 중 (AES-256 · DPAPI)" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtVaultDiagnostics" Grid.Column="1" Text="파일 손상 검사 통과 (SHA-256)" FontSize="10" Foreground="#94A3B8" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="2" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="✓ 암호화 보호 정상" FontSize="9.5" FontWeight="Bold" Foreground="#6EE7B7"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- List DataGrids -->
        <!-- Deleted Tab DataGrid -->
        <Border x:Name="PanelDeletedContent" Grid.Row="3" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="GridTrash"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      Background="{DynamicResource BgCardBrush}"
                      RowBackground="{DynamicResource BgCardBrush}"
                      AlternatingRowBackground="{DynamicResource BgDarkBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      HeadersVisibility="Column"
                      RowHeight="48"
                      FrozenColumnCount="1">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2563EB"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="번호" Width="45" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IndexNumber}" 
                                           FontFamily="Consolas, Courier New, monospace" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="ChkItem_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="삭제 일시" Width="140" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DeletedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="인증서 소유자명" Width="180" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CertCommonName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="원래 보관 경로" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OriginalDirectoryPath}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           FontSize="11" 
                                           TextWrapping="Wrap" 
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding OriginalDirectoryPath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="복원 동작" Width="90" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="↩️ 복원" Style="{StaticResource SuccessButton}" Padding="8,4" Click="BtnRestoreItem_Click" Margin="4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Restored Tab Detailed Card Layout -->
        <Border x:Name="PanelRestoredContent" Grid.Row="3" Background="Transparent" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ListRestoredCards">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Card Header (Index, CN, Status Badge, Restore to USB, Audit Proof, Delete Button) -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="28" Height="22" Background="{DynamicResource BgDarkBrush}" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IndexNumber, StringFormat='#\{0\}'}" FontFamily="Consolas, Courier New, monospace" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CertCommonName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                            </Border>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusBadge}" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <Button Grid.Column="3" Content="💾 USB로 복구" Style="{StaticResource SuccessButton}" Padding="8,4" Click="BtnRestoreRestoredToUsb_Click" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                        <Button Grid.Column="4" Content="🔍 검사 기록" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="BtnShowProof_Click" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="파일 손상 검사(SHA-256) 및 암호화 기록 보기"/>

                                        <Button Grid.Column="5" Content="🗑️ 삭제" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="BtnDeleteRestoredItem_Click" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Row 1: Restoration Timestamp & Previous Delete Reason -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🕒 복원 완료 시각: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding RestoredAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,6" Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚠️ 이전 삭제 사유: " FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                                <TextBlock Text="{Binding DeleteReason}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Row 2: Integrity Verification Status Before & After Restore (복구 전/후 무결성 상태) -->
                                    <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Before Restore -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🔒 복구 전 파일 검사" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding IntegrityBefore}" FontSize="11" Foreground="#E2E8F0" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Arrow Divider -->
                                            <TextBlock Grid.Column="1" Text=" ➔ " FontSize="14" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="8,0"/>

                                            <!-- After Restore -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="⚡ 복구 후 확인" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                                <TextBlock Text="{Binding IntegrityAfter}" FontSize="11" Foreground="#E2E8F0" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Row 3: Protected Encrypted Vault Container File Path & Actions -->
                                    <Border Grid.Row="3" Background="#0B132B" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="🔒 암호화 백업 파일:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                                        <TextBlock Text="AES-256 · DPAPI 보호" FontSize="9.5" FontWeight="Bold" Foreground="#6EE7B7"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding EncryptedZipPath}" FontSize="11" FontFamily="Consolas, Courier New, monospace" Foreground="#7DD3FC" ToolTip="{Binding EncryptedZipPath}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding FormattedCompressedSize, StringFormat='크기: \{0\} (무단 열람 차단)'}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Button Content="🔍 파일 검사" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="BtnVerifyArchive_Click" Margin="0,0,6,0" ToolTip="암호화 백업 파일 손상 여부 검사"/>
                                                <Button Content="📁 보관 폴더" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="BtnOpenItemVaultFolder_Click" ToolTip="암호화 보관 폴더 열기"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Row 4: System Restored Destination Path -->
                                    <Border Grid.Row="4" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,7">
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📂 복원 위치: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding OriginalDirectoryPath}" FontSize="11" FontFamily="Consolas, Courier New, monospace" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding OriginalDirectoryPath}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="사용 가능한 위치로 복원되었으며, 내 PC 금고에도 암호화 백업이 안전하게 유지됩니다." FontSize="9.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Security Banner -->
        <Border Grid.Row="4" Background="#064E3B" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="복원 기록은 이중 암호화 보호(AES-256 · DPAPI)로 저장되어 외부 무단 열람을 차단합니다." 
                           Foreground="#A7F3D0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="5" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="12" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="TxtTrashCount" Text="휴지통: 0개 | 복원 보관함: 0개" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Content="닫기" Style="{StaticResource PrimaryButton}" Width="80" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
