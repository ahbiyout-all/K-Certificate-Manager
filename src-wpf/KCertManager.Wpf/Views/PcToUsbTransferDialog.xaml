<Window x:Class="KCertManager.Wpf.Views.PcToUsbTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KCertManager.Wpf.ViewModels"
        Title="내 컴퓨터(PC) ➔ USB 메모리 / 디스크 인증서 복사하기" 
        Height="660" Width="840"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDarkBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Title Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Drive Selection -->
            <RowDefinition Height="Auto"/>
            <!-- 2: No USB Tip Banner (Compact Info) -->
            <RowDefinition Height="Auto"/>
            <!-- 3: PC Certificates DataGrid Table -->
            <RowDefinition Height="*"/>
            <!-- 4: Conflict Strategy -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Bottom Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Title Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="💻" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="내 컴퓨터(PC) ➔ USB 메모리 / 디스크 인증서 복사하기" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="컴퓨터(로컬 보관함)에 저장된 공인인증서를 선택하여 연결된 이동식 USB 메모리 또는 로컬 디스크로 안전하게 복사/백업합니다." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 1. Destination Drive Selection (Always Enabled, C: / USB listed) -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="복사 목적지 드라이브 (USB · 디스크):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedTargetDrive}"
                          DisplayMemberPath="DisplayName" Height="32" FontSize="12" Margin="0,0,12,0"
                          IsEnabled="True"/>

                <Button Grid.Column="2" Command="{Binding RefreshDrivesCommand}" Style="{StaticResource SecondaryButton}" Content="🔄 드라이브 갱신" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- 2. USB Missing Info Tip Banner (Only shows when no USB is plugged in, does NOT block the table!) -->
        <Border Grid.Row="2" Background="#2A1B0A" BorderBrush="#D97706" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding HasRemovableUsb, Converter={StaticResource InverseBoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="이동식 USB 메모리가 연결되지 않아 기본 로컬 디스크(C:\)가 선택되었습니다." FontWeight="Bold" Foreground="#FDE68A" FontSize="11.5"/>
                    <TextBlock Text="인증서를 USB로 복사하시려면 본체에 USB 메모리를 꽂으신 후 우측 [🔄 드라이브 갱신]을 눌러주세요." Foreground="#FEF3C7" FontSize="10.5" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Content Area: DataGrid of PC Certificates (ALWAYS VISIBLE!) -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <!-- 3-1. Certificates DataGrid (When Certificates Found) -->
            <Border Visibility="{Binding HasCertificates, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource BgCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Table Action Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" CornerRadius="8,8,0,0" Padding="10,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="복사할 인증서를 체크(선택)해 주세요:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Content="전체 선택" Padding="8,2" Margin="0,0,6,0" FontSize="11"/>
                                <Button Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButton}" Content="선택 해제" Padding="8,2" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FoundPcCertificates}" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" RowBackground="{DynamicResource BgCardBrush}" AlternatingRowBackground="{DynamicResource BgDarkBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              FrozenColumnCount="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <!-- Highlight colors -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2563EB"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1D4ED8"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

                            <!-- DataGrid Column Header Style -->
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource BgDarkBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="번호" Binding="{Binding IndexNumber}" Width="45" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <DataGridCheckBoxColumn Header="선택" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="구분" Binding="{Binding CategoryBadgeText}" Width="110" Foreground="{DynamicResource AccentTextBrush}"/>
                            <DataGridTextColumn Header="인증서 명칭 (CN)" Binding="{Binding CommonName}" Width="*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="발급기관" Binding="{Binding IssuerName}" Width="145" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DataGridTextColumn Header="만료일" Binding="{Binding NotAfter, StringFormat='{}{0:yyyy-MM-dd}'}" Width="105" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 3-2. Empty State when NO Certificates Found on PC -->
            <Border Visibility="{Binding HasCertificates, Converter={StaticResource InverseBoolToVis}}"
                    Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="32"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📂" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="컴퓨터에 보관된 공인인증서가 감지되지 않았습니다" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="컴퓨터의 표준 보관함(AppData\LocalLow\NPKI, C:\NPKI 등)에 인증서가 존재하는지 확인해 주세요." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Conflict Strategy Options -->
        <Border Grid.Row="4" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="동일 인증서 감지 시:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <RadioButton Content="⚡ 스마트 덮어쓰기 (최신 파일 자동 갱신)" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand"
                             Checked="RbOverwrite_Checked"/>
                <RadioButton Content="📁 날짜 백업본 보존" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand"
                             Checked="RbRename_Checked"/>
                <RadioButton Content="⏭️ 건너뛰기" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" VerticalAlignment="Center" Cursor="Hand"
                             Checked="RbSkip_Checked"/>
            </StackPanel>
        </Border>

        <!-- 5. Bottom Action buttons -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="Close_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Content="닫기" Padding="16,8"/>
                <Button Command="{Binding TransferToUsbCommand}" Style="{StaticResource SuccessButton}" Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ConfirmButtonText}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
