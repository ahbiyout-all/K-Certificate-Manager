<Window x:Class="KCertManager.Wpf.Views.StartupWorkflowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🚀 K-인증서 매니저 시작 작업 선택" 
        Height="580" Width="912"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgDarkBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="10">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Background="#1E3A8A" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="🚀 K-WORKFLOW" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                    </Border>
                    <TextBlock Text="시작 작업 선택" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="원하는 작업을 누르면 순서대로 안내합니다." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <Separator Grid.Row="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

            <!-- 3 Main Workflow Selection Cards -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: PC -> USB Backup -->
                <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16" Cursor="Hand" MouseLeftButtonDown="CardPcToUsb_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="44" Height="44" CornerRadius="22" Background="#1E3A8A" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="💻 ➔ 💾" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="PC ➔ USB 복사" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Text="내 PC 인증서를 USB 메모리에 안전하게 복사합니다." FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Border Grid.Row="3" Background="#0F172A" CornerRadius="6" Padding="8,6" Margin="0,12,0,0">
                            <TextBlock Text="⚡ 3단계 안내 복사" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: USB -> PC Import -->
                <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16" Cursor="Hand" MouseLeftButtonDown="CardUsbToPc_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="44" Height="44" CornerRadius="22" Background="#065F46" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="💾 ➔ 💻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="USB ➔ PC 가져오기" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Text="USB 인증서를 내 PC 표준 폴더로 바로 가져옵니다." FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Border Grid.Row="3" Background="#0F172A" CornerRadius="6" Padding="8,6" Margin="0,12,0,0">
                            <TextBlock Text="📥 바로 가져오기" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3: Main Dashboard -->
                <Border Grid.Column="4" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16" Cursor="Hand" MouseLeftButtonDown="CardMainDashboard_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="44" Height="44" CornerRadius="22" Background="#581C87" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="🖥️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="전체 인증서 보기" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Text="인증서 목록, 만료일, 드라이브 현황을 한눈에 봅니다." FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Border Grid.Row="3" Background="#0F172A" CornerRadius="6" Padding="8,6" Margin="0,12,0,0">
                            <TextBlock Text="📊 메인 화면 이동" FontSize="11" FontWeight="SemiBold" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Actions & Collapsible Route Guide -->
            <StackPanel Grid.Row="3">
                <Expander Header="표준 저장 폴더 안내 보기" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,10">
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="6" Padding="10,8" Margin="0,4,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="• 은행·공동 인증서 (NPKI): AppData\LocalLow\NPKI  |  • 공무원 인증서 (GPKI): C:\GPKI\Certificate\class2" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Expander>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="AlwaysShowCheckBox" IsChecked="True" Content="시작할 때 항상 이 창 표시" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Click="Close_Click" Style="{StaticResource SecondaryButton}" Padding="20,8" Content="닫기"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
