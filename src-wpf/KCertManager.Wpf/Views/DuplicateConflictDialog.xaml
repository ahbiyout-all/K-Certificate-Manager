<Window x:Class="KCertManager.Wpf.Views.DuplicateConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚠️ 같은 인증서 확인"
        Width="680" Height="580"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Explanation Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Conflict List -->
            <RowDefinition Height="*"/>
            <!-- 3: Action Choice -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14" BorderBrush="#D97706" BorderThickness="1.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#78350F" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="같은 인증서가 이미 있습니다" FontSize="16" FontWeight="Bold" Foreground="#FDE68A" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Border Background="#B45309" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtConflictCountBadge" Text="1건 감지됨" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock x:Name="TxtHeaderDesc" Text="대상 위치에 같은 인증서가 있습니다. 처리 방법을 선택하세요." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Explanation Banner -->
        <Border Grid.Row="1" Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="💡 선택 도움말" FontWeight="Bold" Foreground="#FDE68A" FontSize="11.5" Margin="0,0,0,2"/>
                <TextBlock Text="새로 갱신한 인증서면 [덮어쓰기], 기존 파일을 남기려면 [따로 보관] 또는 [건너뛰기]를 선택하세요." FontSize="11" Foreground="#FEF3C7" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 2. Conflict Items List -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="중복된 인증서 목록" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelConflictList">
                        <!-- Dynamically filled in code-behind -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. Conflict Resolution Selector -->
        <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="처리 방법 선택" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Vertical">
                    <RadioButton x:Name="RbOverwrite" Content="⚡ 덮어쓰기 (최신 파일로 교체 · 권장)" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" Cursor="Hand"/>
                    <RadioButton x:Name="RbRename" Content="📁 기존 파일 따로 보관 (_backup)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,8" Cursor="Hand"/>
                    <RadioButton x:Name="RbSkip" Content="⏭️ 건너뛰기 (기존 파일 유지)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 4. Footer Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtTargetDriveSummary" Grid.Column="0" Text="대상 드라이브: E:\" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" Content="복사 취소" Padding="16,8" Margin="0,0,10,0"/>
                <Button Click="BtnConfirm_Click" Style="{StaticResource PrimaryButton}" Padding="18,8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Margin="0,0,6,0" FontWeight="Bold"/>
                        <TextBlock Text="선택한 방식으로 복사 진행" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
