<Window x:Class="KCertManager.Wpf.Views.DuplicateConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚠️ [중복 방지 체크] 동일 인증서 감지 및 덮어쓰기 확인"
        Width="680" Height="580"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Explanation Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Conflict List -->
            <RowDefinition Height="*"/>
            <!-- 3: Action Choice -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14" BorderBrush="#D97706" BorderThickness="1.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#78350F" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="중복 방지 체크 (동일 인증서 덮어쓰기 확인)" FontSize="16" FontWeight="Bold" Foreground="#FDE68A" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Border Background="#B45309" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtConflictCountBadge" Text="1건 감지됨" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock x:Name="TxtHeaderDesc" Text="복사 대상 드라이브에 원본과 동일한 인증서 폴더가 이미 존재합니다. 덮어쓰기 여부를 선택해 주세요." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Explanation Banner -->
        <Border Grid.Row="1" Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="💡 안전한 인증서 관리를 위한 안내" FontWeight="Bold" Foreground="#FDE68A" FontSize="11.5" Margin="0,0,0,3"/>
                <TextBlock Text="인증서를 은행이나 기관에서 새로 갱신 발급받은 경우 [덮어쓰기]를 권장하며, 기존 구버전 인증서를 유지하고 싶다면 [이름 변경 보존] 또는 [건너뛰기]를 선택하세요." FontSize="11" Foreground="#FEF3C7" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 2. Conflict Items List -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="대상 드라이브에서 발견된 중복 인증서 목록:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelConflictList">
                        <!-- Dynamically filled in code-behind -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. Conflict Resolution Selector -->
        <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="중복 인증서 처리 방식 선택:" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Vertical">
                    <RadioButton x:Name="RbOverwrite" Content="⚡ 덮어쓰기 (기존 인증서를 최신 원본 파일로 갱신 교체 - 권장)" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" Cursor="Hand"/>
                    <RadioButton x:Name="RbRename" Content="📁 이름 변경 보존 (기존 폴더를 _backup으로 백업 후 새로 복사)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,8" Cursor="Hand"/>
                    <RadioButton x:Name="RbSkip" Content="⏭️ 건너뛰기 (기존 인증서를 그대로 유지하고 복사 스킵)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 4. Footer Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtTargetDriveSummary" Grid.Column="0" Text="대상 드라이브: E:\" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" Content="복사 취소" Padding="16,8" Margin="0,0,10,0"/>
                <Button Click="BtnConfirm_Click" Style="{StaticResource PrimaryButton}" Padding="18,8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Margin="0,0,6,0" FontWeight="Bold"/>
                        <TextBlock Text="선택한 방식으로 복사 계속 진행" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
