<Window x:Class="KCertManager.Wpf.Views.ActivityLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작업 및 보안 감사 로그 (KCert Audit Logger)"
        Width="850" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" Background="#1E3A8A" CornerRadius="8" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📝" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="실시간 작업 및 보안 감사 로그" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="인증서 스캔, 백업, 금고 패키징, 삭제/복원 등 모든 활동이 디스크에 암호화 보존 및 기록됩니다." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📄 로그 파일 내보내기 (.txt)" Style="{StaticResource PrimaryButton}" Click="BtnExportLogs_Click" Margin="0,0,8,0"/>
                    <Button Content="🧹 로그 지우기" Style="{StaticResource SecondaryButton}" Click="BtnClearLogs_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter & Search Bar -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Category Filters -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="전체 (ALL)" Tag="ALL" IsChecked="True" Style="{StaticResource SidebarNavRadio}" Click="Filter_Click" Margin="0,0,6,0"/>
                    <RadioButton Content="백업 (BACKUP)" Tag="BACKUP" Style="{StaticResource SidebarNavRadio}" Click="Filter_Click" Margin="0,0,6,0"/>
                    <RadioButton Content="보안금고 (VAULT)" Tag="VAULT" Style="{StaticResource SidebarNavRadio}" Click="Filter_Click" Margin="0,0,6,0"/>
                    <RadioButton Content="삭제/복원" Tag="DELETE_RESTORE" Style="{StaticResource SidebarNavRadio}" Click="Filter_Click" Margin="0,0,6,0"/>
                    <RadioButton Content="스캔/조회" Tag="SCAN" Style="{StaticResource SidebarNavRadio}" Click="Filter_Click"/>
                </StackPanel>

                <!-- Search box -->
                <TextBox Grid.Column="1" x:Name="TxtSearchLog" Width="200" HorizontalAlignment="Right" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,4" FontSize="12" TextChanged="TxtSearchLog_TextChanged"/>
            </Grid>
        </Border>

        <!-- Log List DataGrid -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="2" BorderBrush="#334155" BorderThickness="1">
            <DataGrid x:Name="GridLogs"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="#1E293B"
                      RowBackground="#1E293B"
                      AlternatingRowBackground="#0F172A"
                      Foreground="#F8FAFC"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#334155"
                      HeadersVisibility="Column"
                      RowHeight="40">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#F8FAFC"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="발생 시각" Binding="{Binding FormattedTime}" Width="140"/>
                    <DataGridTextColumn Header="분류" Binding="{Binding CategoryBadgeText}" Width="85"/>
                    <DataGridTextColumn Header="작업 명칭" Binding="{Binding Action}" Width="150"/>
                    <DataGridTextColumn Header="세부 내용" Binding="{Binding Details}" Width="*"/>
                    <DataGridTextColumn Header="대상 경로" Binding="{Binding Target}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,12,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="TxtLogCount" Text="총 0건의 감사 로그 기록" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <Button Content="닫기" Style="{StaticResource PrimaryButton}" Width="80" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
