<Window x:Class="KCertManager.Wpf.Views.SecurityGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보안 가이드 및 KCert.Core 기술 규격 (Security Guide &amp; Core Specs)"
        Width="780" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" Background="#1E3A8A" CornerRadius="8" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="보안 수칙 및 핵심 엔진 안내" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="안전한 인증서 관리 수칙과 자체 오프라인 엔진 구조" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BgCardBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: 핵심 보안 수칙 -->
            <TabItem Header="📋 인증서 5대 보안 수칙">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14">
                    <StackPanel>
                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="1. 개인키 파일(signPri.key) 메일·클라우드 전송 금지" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" FontSize="13"/>
                                <TextBlock Text="비밀번호가 있어도 개인키 파일은 이메일·메신저·클라우드에 올리지 마세요." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="2. 공용 PC 저장 금지 및 사용 후 바로 삭제" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" FontSize="13"/>
                                <TextBlock Text="공용 PC에서는 USB로만 사용하고 끝난 뒤 바로 삭제하세요." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="3. 백업 시 암호화 보호 (.kcertpack) 사용 권장" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" FontSize="13"/>
                                <TextBlock Text="중요 백업은 암호화 금고(.kcertpack, AES-256)로 한번 더 잠궈 보관하세요." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="4. 전용 보안 USB 사용 및 분실 주의" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" FontSize="13"/>
                                <TextBlock Text="이동 시에는 보안 USB나 전용 이동식 메모리에 따로 보관하세요." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="5. 만료 30일 전 갱신 및 만료 인증서 정리" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" FontSize="13"/>
                                <TextBlock Text="만료된 인증서는 혼동되지 않도록 휴지통으로 정리하세요." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Expander Header="자주 쓰는 USB · PC 표준 폴더 구조 보기" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,4,0,0">
                            <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10" Margin="0,4,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="• 은행·공동 인증서 (NPKI): USB:\NPKI  |  PC: AppData\LocalLow\NPKI&#x0a;• 공무원 인증서 (GPKI): USB:\GPKI\Certificate\class2  |  PC: C:\GPKI\Certificate\class2&#x0a;• 교육기관 인증서 (EPKI): USB:\EPKI  |  PC: AppData\LocalLow\EPKI" FontSize="11" FontFamily="Consolas, Malgun Gothic" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18" TextWrapping="Wrap"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: KCert.Core 4대 모듈 규격 -->
            <TabItem Header="⚙️ 핵심 엔진 구조 (KCert.Core)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14">
                    <StackPanel>
                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="1. 인증서 읽기 엔진 (KCert.Core.Parser · X.509)" FontWeight="Bold" Foreground="#34D399" FontSize="13"/>
                                <TextBlock Text="소유자, 발급기관, 용도, 만료일 정보를 외부 프로그램 없이 안전하게 읽어옵니다." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="2. 폴더 자동 탐색 엔진 (KCert.Core.Discovery)" FontWeight="Bold" Foreground="#34D399" FontSize="13"/>
                                <TextBlock Text="PC와 USB의 NPKI · GPKI · EPKI 표준 폴더를 빠르게 찾습니다." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="3. 암호화 금고 및 휴지통 (KCert.Core.Vault · AES-256)" FontWeight="Bold" Foreground="#34D399" FontSize="13"/>
                                <TextBlock Text="백업 파일 암호화(AES-256)와 실수 삭제 복원 휴지통을 제공합니다." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="4. USB 실시간 감지 및 오프라인 보호 (HardwareGuard)" FontWeight="Bold" Foreground="#34D399" FontSize="13"/>
                                <TextBlock Text="USB 연결·해제를 바로 감지하며 외부 서버 전송 없이 내 PC에서만 동작합니다." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Button Content="확인" Style="{StaticResource PrimaryButton}" Width="90" HorizontalAlignment="Right" Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>
