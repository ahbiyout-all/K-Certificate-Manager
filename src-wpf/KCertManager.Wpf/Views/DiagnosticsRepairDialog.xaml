<Window x:Class="KCertManager.Wpf.Views.DiagnosticsRepairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="중복 인증서 정리 · 잘못된 폴더 자동 복구"
        Width="860" Height="680"
        MinWidth="740" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="LocalBoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🧹 중복 인증서 정리 · 잘못된 폴더 자동 복구" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="동일 인증서 사본은 안전하게 휴지통으로 격리하고, 인식되지 않는 폴더는 표준 위치로 복구합니다." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="BtnClose_Click" Style="{StaticResource TitleBarCloseButton}" VerticalAlignment="Top" ToolTip="닫기">
                    <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Border>

        <!-- 2. Tab Switcher & Summary Strip -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnTabDuplicates" Click="BtnTabDuplicates_Click" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 중복 인증서 정리 " FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="TxtTabDupCount" Text="(0)" FontWeight="ExtraBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnTabRepairs" Click="BtnTabRepairs_Click" Style="{StaticResource SecondaryButton}" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛠️ 잘못된 폴더 자동 복구 " FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="TxtTabRepairCount" Text="(0)" FontWeight="ExtraBold" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TxtSummaryStats" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="전체 스캔 0건" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- 3. Inline Feedback Banner -->
        <Border x:Name="BannerFeedback" Grid.Row="2" Visibility="Collapsed" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFeedbackMessage" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#A7F3D0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Click="BtnDismissFeedback_Click" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="8,0,0,0">
                    <TextBlock Text="✕" FontSize="10"/>
                </Button>
            </Grid>
        </Border>

        <!-- 4. Tab Content Area -->
        <Grid Grid.Row="3">
            <!-- TAB 1: Duplicates Panel -->
            <Grid x:Name="PanelDuplicates" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🛡️ 각 묶음의 표준 원본 1개는 자동 보존되며 삭제되지 않습니다. 선택한 사본만 휴지통으로 이동합니다."
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Click="BtnSelectRecommendedDups_Click" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0">
                            <TextBlock Text="권장 항목만 선택" FontSize="11"/>
                        </Button>
                        <Button Click="BtnDeselectAllDups_Click" Style="{StaticResource SecondaryButton}" Padding="10,5">
                            <TextBlock Text="선택 해제" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Empty State -->
                <Border x:Name="EmptyDuplicatesState" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource BgCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="30">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="✓ 중복 저장된 인증서가 없습니다" FontSize="15" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                        <TextBlock Text="PC와 USB에 중복 없이 깔끔하게 보관되어 있습니다." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Duplicate Groups ScrollViewer -->
                <ScrollViewer x:Name="ScrollDuplicates" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListDuplicateGroups">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" ClipToBounds="True">
                                    <StackPanel>
                                        <!-- Group Header -->
                                        <Border Background="{DynamicResource BgDarkBrush}" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CommonName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding MetaInfo}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CopyCountBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Preserved Primary Row -->
                                        <Border Background="#0B2E26" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding PrimaryLabel}" FontSize="11.5" FontWeight="Bold" Foreground="#34D399"/>
                                                <TextBlock Text="{Binding PrimaryPath}" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PrimaryPath}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Redundant Copies List -->
                                        <ItemsControl ItemsSource="{Binding RedundantCopies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding LocationLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding DirectoryPath}" FontSize="10.5" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryPath}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: Non-Standard Folder Auto-Repair Panel -->
            <Grid x:Name="PanelRepairs" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🛠️ 표준 경로로 먼저 안전 복사 및 파일 손상 검사(SHA-256)를 완료한 뒤 기존 비표준 폴더를 정리합니다."
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <CheckBox x:Name="ChkTrashSourceAfterRepair" Grid.Column="1" IsChecked="True" Content="복구 후 기존 잘못된 폴더를 휴지통으로 정리"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <!-- Empty State -->
                <Border x:Name="EmptyRepairsState" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource BgCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="30">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="✓ 잘못된 폴더 위치가 감지되지 않았습니다" FontSize="15" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                        <TextBlock Text="모든 인증서가 정부(GPKI)·교육(EPKI)·은행(NPKI) 표준 경로에 보관되어 있습니다." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Repair Candidates List -->
                <ScrollViewer x:Name="ScrollRepairs" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListRepairCandidates">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CommonName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding IssueTitle}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding IssueDescription}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,8" TextWrapping="Wrap"/>

                                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="현재 위치 (비표준 · 미인식)" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                                                        <TextBlock Text="{Binding SourcePath}" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="➔" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="10,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="복구 위치 (표준 경로)" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                                        <TextBlock Text="{Binding CanonicalPreviewPath}" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="#6EE7B7" TextTrimming="CharacterEllipsis" ToolTip="{Binding CanonicalPreviewPath}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 5. Bottom Footer Actions -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFooterHint" Text="선택한 항목만 안전하게 정리됩니다." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="BtnClose_Click" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,0">
                    <TextBlock Text="닫기" FontSize="12"/>
                </Button>

                <Button x:Name="BtnExecuteDuplicates" Click="BtnExecuteDuplicates_Click" Background="#D97706" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️ " FontSize="12"/>
                        <TextBlock Text="선택한 중복 사본 휴지통 이동" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnExecuteRepairs" Click="BtnExecuteRepairs_Click" Visibility="Collapsed" Style="{StaticResource SuccessButton}" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ " FontSize="12"/>
                        <TextBlock Text="선택한 폴더 표준 위치로 자동 복구" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
