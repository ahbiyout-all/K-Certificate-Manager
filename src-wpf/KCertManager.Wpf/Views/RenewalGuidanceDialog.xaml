<Window x:Class="KCertManager.Wpf.Views.RenewalGuidanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="인증서 갱신 센터 안내 (Certificate Renewal Guidance Center)"
        Width="920" Height="680"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" Background="#2563EB" CornerRadius="10" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🌐" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="인증서 갱신 및 발급기관 센터 안내" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#1E3A8A" CornerRadius="12" Padding="8,2" Margin="10,0,0,0" BorderBrush="#3B82F6" BorderThickness="1">
                            <TextBlock Text="공식 인증 센터 연동" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="만료 30일 전 적시 갱신을 지원합니다. 해당 발급기관 웹사이트로 안전하게 이동하여 갱신할 수 있습니다." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnRefreshList" Content="🔄 보유 상태 갱신" Style="{StaticResource SecondaryButton}" Click="BtnRefreshList_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Filter & Search Bar -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Category Radio Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RadioCatAll" Content="전체" IsChecked="True" Click="CategoryRadio_Click" Tag="ALL" Style="{StaticResource ThemeRadioBtn}" Margin="0,0,4,0"/>
                    <RadioButton x:Name="RadioCatGov" Content="정부·행정 (GPKI)" Click="CategoryRadio_Click" Tag="GOV" Style="{StaticResource ThemeRadioBtn}" Margin="0,0,4,0"/>
                    <RadioButton x:Name="RadioCatEdu" Content="교육청 (EPKI)" Click="CategoryRadio_Click" Tag="EDU" Style="{StaticResource ThemeRadioBtn}" Margin="0,0,4,0"/>
                    <RadioButton x:Name="RadioCatBank" Content="은행·금융" Click="CategoryRadio_Click" Tag="BANK" Style="{StaticResource ThemeRadioBtn}" Margin="0,0,4,0"/>
                    <RadioButton x:Name="RadioCatCorp" Content="법인·공동 (KICA 등)" Click="CategoryRadio_Click" Tag="CORP" Style="{StaticResource ThemeRadioBtn}" Margin="0,0,4,0"/>
                    <RadioButton x:Name="RadioCatStock" Content="증권 (SignKorea)" Click="CategoryRadio_Click" Tag="STOCK" Style="{StaticResource ThemeRadioBtn}"/>
                </StackPanel>

                <!-- Search Input -->
                <Border Grid.Column="1" Width="200" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtSearchKeyword" TextChanged="TxtSearchKeyword_TextChanged"
                                 Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Items List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ItemsInstitutions">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header Row: Name, Category Tag, Cert Status -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <Border Background="#0F172A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" BorderBrush="#475569" BorderThickness="1">
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Matched Certificates Count Pill -->
                                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="8,4" BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="{Binding CertSummaryText}" FontSize="12" FontWeight="Bold" Foreground="{Binding CertSummaryColor}"/>
                                    </Border>
                                </Grid>

                                <!-- Description & Guide -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="📌 갱신 위치: " FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding MenuGuide}" FontSize="11" Foreground="#60A5FA"/>
                                        <TextBlock Text="  |  📞 고객센터: " FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding CallCenter}" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Notice}" FontSize="11" Foreground="#FDA4AF" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Action Buttons Row -->
                                <Border Grid.Row="2" Background="#0F172A" CornerRadius="6" Padding="10,8" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔗 " FontSize="12"/>
                                            <TextBlock Text="{Binding PortalUrl}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="📋 주소 복사" Tag="{Binding PortalUrl}" Click="BtnCopyUrl_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11"/>
                                            <Button Content="🔍 네이버 검색" Tag="{Binding ShortName}" Click="BtnSearchNaver_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11"/>
                                            <Button Content="🚀 포털 이동" Tag="{Binding PortalUrl}" Click="BtnOpenPortal_Click" Style="{StaticResource PrimaryButton}" Padding="12,4" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,14,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <TextBlock Text="※ K-인증서 매니저는 브라우저 외부의 공식 보안 웹사이트 주소로 안전하게 연결해 드립니다." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <Button Content="닫기" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click" HorizontalAlignment="Right" Width="80"/>
            </Grid>
        </Border>
    </Grid>
</Window>
