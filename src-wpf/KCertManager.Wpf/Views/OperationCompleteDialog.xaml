<Window x:Class="KCertManager.Wpf.Views.OperationCompleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작업 완료 안내 (K-인증서 매니저)"
        Width="720" Height="660"
        MinWidth="640" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Banner with Green/Emerald Theme -->
        <Border Grid.Row="0" Background="#064E3B" CornerRadius="10" Padding="16,14" Margin="0,0,0,12" BorderBrush="#059669" BorderThickness="1.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Success Icon -->
                <Border Width="46" Height="46" Background="#10B981" CornerRadius="10" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✓" FontSize="26" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Border Background="#047857" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="작업 완료 (SUCCESS)" FontSize="10.5" FontWeight="ExtraBold" Foreground="#A7F3D0"/>
                        </Border>
                        <TextBlock Text="🛡️ 파일 손상 없음 확인 (SHA-256)" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTitle" Text="인증서 복사 완료!" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtSubtitle" Text="선택한 인증서를 안전하게 복사했습니다." FontSize="11" Foreground="#D1FAE5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Click="BtnClose_Click" Style="{StaticResource TitleBarCloseButton}" VerticalAlignment="Top" ToolTip="닫기">
                    <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Border>

        <!-- 2. Transfer Route & Metrics Summary Card -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Metrics Row -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Metric 1: Count -->
                    <Border Grid.Column="0" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="복사 완료 건수" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtCount" Text="0" FontSize="18" FontWeight="ExtraBold" Foreground="#34D399"/>
                                <TextBlock Text=" 건 성공" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Metric 2: Integrity -->
                    <Border Grid.Column="1" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="파일 검사" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="손상 없음 (SHA-256)" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Metric 3: Timestamp -->
                    <Border Grid.Column="2" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="완료 시각" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtTimestamp" Text="방금 전" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Route Flow -->
                <Border Grid.Row="1" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Source -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="원본 위치" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtSourcePath" Text="C:\Users\...\AppData\LocalLow\NPKI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Arrow -->
                        <TextBlock Grid.Column="1" Text="➔" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="10,0" VerticalAlignment="Center"/>

                        <!-- Destination -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="저장 위치" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock x:Name="TxtTargetPath" Text="E:\NPKI (USB 메모리)" FontSize="11" FontWeight="Bold" Foreground="#6EE7B7" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 3. List of Copied Certificates -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinHeight="160">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔑 복사 완료된 인증서 목록" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtCertCountBadge" Text=" (0개)" FontSize="11.5" FontWeight="Bold" Foreground="#34D399"/>
                    </StackPanel>
                    <TextBlock Text="인증서·개인키 (signCert·signPri) 확인" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </Grid>

                <ListBox x:Name="ListCertificates" Grid.Row="1"
                         Background="{DynamicResource BgDarkBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Padding="4"
                         MinHeight="120"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="6" Padding="10,7" Margin="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Index Badge -->
                                    <Border Grid.Column="0" Width="22" Height="22" Background="#1E293B" CornerRadius="11" Margin="0,0,8,0" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="{Binding IndexNumber}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Checkmark Badge -->
                                    <Border Grid.Column="1" Width="20" Height="20" Background="#065F46" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#6EE7B7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Cert Name and Issuer/Policy -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Text="{Binding IssuerAndPolicy}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <!-- Copy Complete Status Badge -->
                                    <Border Grid.Column="3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="복사 완료 ✓" FontSize="10" FontWeight="ExtraBold" Foreground="#6EE7B7"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 4. Practical Usage Next Steps Guide Tip (Collapsed by Default) -->
        <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,14" BorderBrush="#1D4ED8" BorderThickness="1">
            <Expander x:Name="ExpanderGuideTip" IsExpanded="False" Foreground="#93C5FD" FontSize="11.5" FontWeight="Bold" Cursor="Hand">
                <Expander.Header>
                    <TextBlock Text="💡 복사 후 사용 안내 보기" FontSize="11.5" FontWeight="Bold" Foreground="#93C5FD"/>
                </Expander.Header>
                <TextBlock x:Name="TxtGuideTip"
                           Margin="0,8,0,2"
                           Text="• 다른 PC에서 USB를 꽂은 뒤 [이동식 디스크]를 선택해 로그인하세요.&#x0a;• 분리 전 작업 표시줄의 '하드웨어 안전하게 제거'를 눌러 주세요."
                           FontSize="10.8" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="17" TextWrapping="Wrap"/>
            </Expander>
        </Border>

        <!-- 5. Bottom Action Buttons -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="BtnCopySummary" Click="BtnCopySummary_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 " FontSize="11"/>
                        <TextBlock x:Name="TxtCopySummary" Text="결과 텍스트 복사" FontSize="11.5"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnOpenFolder" Click="BtnOpenFolder_Click" Style="{StaticResource SecondaryButton}" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 " FontSize="11"/>
                        <TextBlock Text="대상 폴더 열기" FontSize="11.5"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Click="BtnClose_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="20,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓ " FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="확인 (닫기)" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
