<Window x:Class="KCertManager.Wpf.Views.TargetDrivePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📁 복사 목적지 디스크 지정"
        Height="640" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: USB Warning Banner (if no removable drive) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Drive Cards Selection List -->
            <RowDefinition Height="*"/>
            <!-- 3: Conflict Resolution Options -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Action Buttons Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="복사 목적지 디스크(USB · 디스크) 지정" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                        <Border Background="#2563EB" CornerRadius="10" Padding="8,2">
                            <TextBlock x:Name="TxtSelectedCountBadge" Text="인증서 0건 선택됨" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="인증서를 안전하게 보관할 이동식 USB 메모리 또는 로컬 디스크를 선택해 주세요." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="2" Click="BtnRefreshDrives_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,4,0"/>
                        <TextBlock Text="드라이브 새로고침" FontSize="11.5"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 1. USB Missing Warning Banner -->
        <Border x:Name="BorderNoUsbWarning" Grid.Row="1" Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="이동식 USB 메모리가 연결되지 않았습니다." FontWeight="Bold" Foreground="#FDE68A" FontSize="12"/>
                    <TextBlock Text="인증서를 USB로 안전하게 복사/백업하시려면 본체에 USB 메모리를 꽂아주세요. (연결 후 '새로고침' 클릭)" Foreground="#FEF3C7" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Drive Selection List -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="대상 드라이브를 클릭하여 선택하세요:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelDriveList">
                        <!-- Drive Cards dynamically generated in code-behind or template -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. Conflict Resolution Options -->
        <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="목적지에 동일한 인증서가 이미 존재할 경우:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbOverwrite" Content="⚡ 스마트 덮어쓰기 (최신 파일 자동 갱신)" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Margin="0,0,16,0" Cursor="Hand"/>
                    <RadioButton x:Name="RbRename" Content="📁 이름 변경 보존 (날짜 백업본 생성)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Margin="0,0,16,0" Cursor="Hand"/>
                    <RadioButton x:Name="RbSkip" Content="⏭️ 건너뛰기 (스킵)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 4. Action Buttons Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtSelectionStatus" Grid.Column="0" Text="목적지 드라이브를 선택해 주세요." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" Content="취소" Padding="16,8" Margin="0,0,10,0"/>
                <Button x:Name="BtnConfirm" Click="BtnConfirm_Click" Style="{StaticResource SuccessButton}" Padding="18,8" IsEnabled="False" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtConfirmBtnText" Text="선택한 드라이브로 복사 시작" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
