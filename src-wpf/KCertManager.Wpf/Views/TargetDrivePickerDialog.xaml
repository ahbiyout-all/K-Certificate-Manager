<Window x:Class="KCertManager.Wpf.Views.TargetDrivePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📁 복사할 드라이브 선택"
        Height="720" Width="850"
        MinWidth="800" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: USB Warning Banner (if no removable drive) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Drive Cards Selection List -->
            <RowDefinition Height="*"/>
            <!-- 3: Conflict Resolution Options -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Action Buttons Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="복사할 드라이브 선택" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Border Background="#2563EB" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSelectedCountBadge" Text="인증서 0건 선택됨" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="인증서를 저장할 USB 메모리 또는 디스크를 선택하세요." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="2" Click="BtnRefreshDrives_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,4,0"/>
                        <TextBlock Text="드라이브 새로고침" FontSize="11.5"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 1. USB Missing Warning Banner -->
        <Border x:Name="BorderNoUsbWarning" Grid.Row="1" Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="연결된 USB가 없습니다" FontWeight="Bold" Foreground="#FDE68A" FontSize="12"/>
                    <TextBlock Text="USB를 꽂은 뒤 우측 [🔄 새로고침]을 눌러주세요." Foreground="#FEF3C7" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Drive Selection List -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="저장할 드라이브를 선택하세요" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelDriveList">
                        <!-- Drive Cards dynamically generated in code-behind or template -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. Conflict Resolution Options -->
        <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="같은 인증서가 이미 있는 경우:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <WrapPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbOverwrite" Content="⚡ 덮어쓰기 (최신 파일 갱신)" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Margin="0,0,20,4" Cursor="Hand"/>
                    <RadioButton x:Name="RbRename" Content="📁 기존 파일 따로 보관" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Margin="0,0,20,4" Cursor="Hand"/>
                    <RadioButton x:Name="RbSkip" Content="⏭️ 건너뛰기" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Margin="0,0,0,4" Cursor="Hand"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 4. Action Buttons Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtSelectionStatus" Grid.Column="0" Text="저장할 드라이브를 선택해 주세요." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" Content="취소" Padding="16,8" Margin="0,0,10,0"/>
                <Button x:Name="BtnConfirm" Click="BtnConfirm_Click" Style="{StaticResource SuccessButton}" Padding="18,8" IsEnabled="False" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtConfirmBtnText" Text="선택한 드라이브로 복사 시작" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
