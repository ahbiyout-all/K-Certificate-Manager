<Window x:Class="KCertManager.Wpf.Views.CertificateDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="인증서 상세 정보 (KCert Certificate Inspector)"
        Width="700" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" Background="#1E3A8A" CornerRadius="8" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📜" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtCategoryBadge" Text="NPKI (금융/공동)" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,2" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtStorageBadge" Text="💾 USB 이동식 (E:)" Background="#065F46" Foreground="#6EE7B7" FontWeight="Bold" FontSize="11" Padding="8,2" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtStatusBadge" Text="유효함" Background="#065F46" Foreground="#34D399" FontWeight="Bold" FontSize="11" Padding="8,2"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCommonName" Text="인증서 소유자 이름" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtIssuer" Text="발급자: yessignCA Class 1" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="📂 탐색기에서 열기" Style="{StaticResource SecondaryButton}" Click="BtnOpenExplorer_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content Body (Scrollable Details) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- Section 1: 인증서 식별 정보 -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="인증서 식별 및 발급 정보" FontWeight="Bold" FontSize="13" Foreground="#60A5FA" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="주체 (Subject DN)" Foreground="#94A3B8" FontSize="12"/>
                            <TextBox Grid.Column="1" x:Name="TxtSubjectDn" Text="cn=홍길동,ou=개인,ou=yessign,o=yessign,c=kr" IsReadOnly="True" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="발급 기관 (Issuer DN)" Foreground="#94A3B8" FontSize="12"/>
                            <TextBox Grid.Column="1" x:Name="TxtIssuerDn" Text="cn=yessignCA Class 1,ou=AccreditedCA,o=Korea Financial Telecommunications and Clearings Institute,c=kr" IsReadOnly="True" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="일련번호 (Serial No)" Foreground="#94A3B8" FontSize="12"/>
                            <TextBox Grid.Column="1" x:Name="TxtSerial" Text="00:1A:2B:3C:4D:5E" IsReadOnly="True" Background="#0F172A" Foreground="#FCD34D" BorderBrush="#334155" Padding="6,4" FontSize="12" FontFamily="Consolas"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="서명 알고리즘" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="TxtAlgo" Text="sha256WithRSAEncryption (2048 bit)" Foreground="#F8FAFC" FontSize="12"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="용도 및 정책 OID" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="TxtPolicy" Text="은행/신용카드/보험용 개인인증서 (1.2.410.200005.1.1.4)" Foreground="#F8FAFC" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: 유효기간 및 상태 -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="유효 기간 및 만료 상태" FontWeight="Bold" FontSize="13" Foreground="#60A5FA" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="유효 시작 (Not Before)" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="TxtNotBefore" Text="2024-01-01 09:00:00" Foreground="#F8FAFC" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="만료 일시 (Not After)" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="TxtNotAfter" Text="2025-01-01 23:59:59" Foreground="#F8FAFC" FontSize="12"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="남은 유효 기간" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="TxtRemainingDays" Text="245일 남음 (정상 유효)" Foreground="#34D399" FontWeight="Bold" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 3: 파일 시스템 및 무결성 정보 -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="보안 파일 위치 및 지문(Fingerprint)" FontWeight="Bold" FontSize="13" Foreground="#60A5FA" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="보관 디렉터리 경로" Foreground="#94A3B8" FontSize="12"/>
                            <TextBox Grid.Column="1" x:Name="TxtDirectory" Text="C:\Users\User\AppData\LocalLow\NPKI\..." IsReadOnly="True" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="공개 인증서 (signCert.der)" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="TxtDerInfo" Text="2,140 Bytes (존재함)" Foreground="#34D399" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="개인키 (signPri.key)" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="TxtKeyInfo" Text="1,248 Bytes (암호화 보관됨)" Foreground="#34D399" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SHA-256 지문" Foreground="#94A3B8" FontSize="12"/>
                            <TextBox Grid.Column="1" x:Name="TxtSha256" Text="A1B2C3D4..." IsReadOnly="True" Background="#0F172A" Foreground="#93C5FD" BorderBrush="#334155" Padding="6,4" FontSize="11" FontFamily="Consolas"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="키 쌍 무결성 검증" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="TxtIntegrity" Text="인증서-개인키 쌍 정합성 일치 (무결성 통과)" Foreground="#34D399" FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,16,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="📋 경로 복사" Style="{StaticResource SecondaryButton}" Click="BtnCopyPath_Click"/>
                </StackPanel>

                <Button Grid.Column="1" Content="닫기" Style="{StaticResource PrimaryButton}" Width="90" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
