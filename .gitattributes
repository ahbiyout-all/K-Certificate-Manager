# Ensure Windows batch scripts and commands always preserve CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf

# Source code files
*.ts text eol=auto
*.tsx text eol=auto
*.js text eol=auto
*.mjs text eol=auto
*.json text eol=auto
*.css text eol=auto
*.md text eol=auto

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.dll binary
*.exe binary
