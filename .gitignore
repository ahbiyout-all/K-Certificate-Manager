# ==============================================================================
#  K-Certificate Manager - Comprehensive .gitignore
#  Prevents build artifacts, IDE caches, installer outputs & sensitive data leaks
# ==============================================================================

# 1. Node & Web Build
node_modules/
dist/
build/
coverage/
.vite/
bun.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2. .NET / C# WPF Build & Release Artifacts (Prevents GitHub 100MB file limit errors)
release/
bin/
obj/
**/bin/
**/obj/
TestResults/
*.user
*.userosscache
*.suo
*.sln.docstates
*_wpftmp*
*.pdb
*.tmp
*.cache
PublishProfiles/

# 3. Inno Setup Installer Build Output
Output/
_Output/

# 4. IDEs & Editors
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.bak
*.orig

# 5. Operating System Junk
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# 6. Environment & Security (Prevent leaking private keys or secrets)
.env*
!.env.example
*.log
# Prevent accidental committing of user's personal/real digital certificates
*.pfx
*.p12
